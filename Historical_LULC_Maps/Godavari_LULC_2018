// ============================================================
// GODAVARI BASIN - LULC 2018
// Dynamic World
// Training will be done later
// ============================================================


// 1. LOAD GODAVARI BASIN

var basin = ee.FeatureCollection(
  "projects/fine-slice-478618-n5/assets/Godavari_Basin"
);

Map.centerObject(basin, 7);

Map.addLayer(
  basin.style({
    color: "red",
    fillColor: "00000000",
    width: 2
  }),
  {},
  "Godavari Basin"
);


// 2. LOAD DYNAMIC WORLD 2018

var dw2018 = ee.ImageCollection(
  "GOOGLE/DYNAMICWORLD/V1"
)
  .filterBounds(basin)
  .filterDate("2018-01-01", "2019-01-01")
  .select("label")
  .mode()
  .clip(basin);


// 3. PRINT INFORMATION

print("Dynamic World 2018:", dw2018);


// 4. CONVERT TO OUR 6 PROJECT CLASSES

// 0 = Water
// 1 = Forest
// 2 = Agriculture
// 3 = Built-up
// 4 = Barren
// 5 = Grassland/Wasteland

var lulc2018 = ee.Image(0)
  .where(dw2018.eq(0), 0)  // Water
  .where(dw2018.eq(1), 1)  // Trees → Forest
  .where(dw2018.eq(2), 5)  // Grass → Grassland
  .where(dw2018.eq(3), 0)  // Flooded vegetation → Water
  .where(dw2018.eq(4), 2)  // Crops → Agriculture
  .where(dw2018.eq(5), 5)  // Shrub → Grassland
  .where(dw2018.eq(6), 3)  // Built → Built-up
  .where(dw2018.eq(7), 4)  // Bare → Barren
  .where(dw2018.eq(8), 4)  // Snow/Ice → Barren
  .rename("LULC")
  .clip(basin);


// 5. DISPLAY 6-CLASS LULC

var lulcPalette = [
  "419BDF", // Water
  "397D49", // Forest
  "E49635", // Agriculture
  "C4281B", // Built-up
  "A59B8F", // Barren
  "88B053"  // Grassland/Wasteland
];

Map.addLayer(
  lulc2018,
  {
    min: 0,
    max: 5,
    palette: lulcPalette
  },
  "Godavari LULC 2018"
);


// 6. CALCULATE AREA

var areaImage = ee.Image.pixelArea()
  .divide(10000)
  .addBands(lulc2018);

var area2018 = areaImage.reduceRegion({

  reducer: ee.Reducer.sum()
    .group({
      groupField: 1,
      groupName: "class"
    }),

  geometry: basin.geometry(),

  scale: 100,

  bestEffort: true,

  maxPixels: 1e13,

  tileScale: 4
});

print(
  "2018 LULC Area (hectares):",
  area2018
);


// 7. CLASS INFORMATION

print(
  "Classes:",
  "0 Water | 1 Forest | 2 Agriculture | " +
  "3 Built-up | 4 Barren | 5 Grassland/Wasteland"
);


// 8. EXPORT 2018 LULC

Export.image.toDrive({

  image: lulc2018.toByte(),

  description: "Godavari_LULC_2018",

  folder: "Godavari_LULC",

  fileNamePrefix: "Godavari_LULC_2018",

  region: basin.geometry(),

  scale: 10,

  maxPixels: 1e13

});


// ============================================================
// END
// ============================================================

/* ============================================================
   9. HISTORICAL LULC AREA STATISTICS — 2018
   ============================================================ */

var classIDs2018 = [0, 1, 2, 3, 4, 5];

var classNames2018 = [
  "Water",
  "Forest",
  "Agriculture",
  "Built-up",
  "Barren",
  "Grassland_Wasteland"
];

var areaImage2018 = ee.Image.pixelArea()
  .rename("area")
  .addBands(lulc2018.rename("class"));

var areaResult2018 = areaImage2018.reduceRegion({
  reducer: ee.Reducer.sum().group({
    groupField: 1,
    groupName: "class"
  }),
  geometry: basin.geometry(),
  scale: 100,
  maxPixels: 1e13,
  tileScale: 4
});

var areaGroups2018 = ee.List(
  areaResult2018.get("groups")
);

var areaDictionary2018 = ee.Dictionary(
  areaGroups2018.iterate(function(item, accumulator) {

    item = ee.Dictionary(item);

    var classID = ee.Number(item.get("class"));
    var areaM2 = ee.Number(item.get("sum"));

    return ee.Dictionary(accumulator).set(
      classID.format(),
      areaM2
    );

  }, ee.Dictionary({}))
);

var areaFeatures2018 = ee.FeatureCollection(
  classIDs2018.map(function(classID) {

    var areaM2 = ee.Number(
      areaDictionary2018.get(
        ee.Number(classID).format(),
        0
      )
    );

    return ee.Feature(null, {
      Year: 2018,
      Class_ID: classID,
      LULC_Class: classNames2018[classID],
      Area_ha: areaM2.divide(10000),
      Area_km2: areaM2.divide(1000000)
    });

  })
);

print("2018 LULC Area Statistics:", areaFeatures2018);

print(
  "2018 Total Classified Area (km²):",
  areaFeatures2018.aggregate_sum("Area_km2")
);

Export.table.toDrive({
  collection: areaFeatures2018,
  description: "Godavari_LULC_2018_Area_Statistics",
  folder: "Godavari_LULC",
  fileNamePrefix: "Godavari_LULC_2018_Area_Statistics",
  fileFormat: "CSV"
});

// ============================================================
// END AREA STATISTICS
