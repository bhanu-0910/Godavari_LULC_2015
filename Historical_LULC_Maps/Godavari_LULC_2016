
/* ============================================================
   GODAVARI BASIN - LULC 2016
   Dynamic World | Six Project Classes
   ============================================================ */

// 1. LOAD GODAVARI BASIN

var basin = ee.FeatureCollection(
  "projects/fine-slice-478618-n5/assets/Godavari_Basin"
);

Map.centerObject(basin, 7);

Map.addLayer(
  basin.style({
    color: "red",
    fillColor: "00000000",
    width: 2
  }),
  {},
  "Godavari Basin"
);

print(
  "Godavari basin area (km²):",
  basin.geometry().area(1000).divide(1e6)
);


// 2. LOAD DYNAMIC WORLD 2016

var dwCollection2016 = ee.ImageCollection(
  "GOOGLE/DYNAMICWORLD/V1"
)
  .filterBounds(basin)
  .filterDate("2016-01-01", "2017-01-01");

print(
  "2016 Dynamic World image count:",
  dwCollection2016.size()
);

var dw2016 = dwCollection2016
  .select("label")
  .mode()
  .clip(basin);

print("Dynamic World 2016:", dw2016);


// 3. DISPLAY ORIGINAL DYNAMIC WORLD

var dwPalette = [
  "419BDF", // Water
  "397D49", // Trees
  "88B053", // Grass
  "7A87C6", // Flooded vegetation
  "E49635", // Crops
  "DFC35A", // Shrub
  "C4281B", // Built
  "A59B8F", // Bare
  "B39FE1"  // Snow/Ice
];

Map.addLayer(
  dw2016,
  {
    min: 0,
    max: 8,
    palette: dwPalette
  },
  "Dynamic World 2016"
);


// 4. CONVERT TO SIX PROJECT CLASSES
// 0 = Water
// 1 = Forest
// 2 = Agriculture
// 3 = Built-up
// 4 = Barren
// 5 = Grassland/Wasteland

var lulc2016 = dw2016
  .remap(
    [0, 1, 2, 3, 4, 5, 6, 7, 8],
    [0, 1, 5, 0, 2, 5, 3, 4, 4]
  )
  .rename("LULC")
  .toByte()
  .clip(basin);


// 5. DISPLAY SIX-CLASS LULC

var lulcPalette = [
  "419BDF", // Water
  "397D49", // Forest
  "E49635", // Agriculture
  "C4281B", // Built-up
  "A59B8F", // Barren
  "88B053"  // Grassland/Wasteland
];

Map.addLayer(
  lulc2016,
  {
    min: 0,
    max: 5,
    palette: lulcPalette
  },
  "Godavari LULC 2016"
);


// 6. PRELIMINARY CLASS AREA CALCULATION
// Use 100 m scale to reduce computation time.
// These are preliminary estimates, not final statistics.

var areaImage = ee.Image.pixelArea()
  .divide(10000)
  .rename("area_ha")
  .addBands(lulc2016.rename("class"));

var area2016 = areaImage.reduceRegion({
  reducer: ee.Reducer.sum().group({
    groupField: 1,
    groupName: "class"
  }),
  geometry: basin.geometry(),
  scale: 100,
  maxPixels: 1e13,
  tileScale: 4
});

print("2016 LULC area (hectares, preliminary):", area2016);

print(
  "Class codes:",
  "0 Water | 1 Forest | 2 Agriculture | " +
  "3 Built-up | 4 Barren | 5 Grassland/Wasteland"
);


// 7. EXPORT 2016 LULC
// Keep the export at 10 m.

Export.image.toDrive({
  image: lulc2016,
  description: "Godavari_LULC_2016",
  folder: "Godavari_LULC",
  fileNamePrefix: "Godavari_LULC_2016",
  region: basin.geometry(),
  scale: 10,
  maxPixels: 1e13
});

// ============================================================
// END
// ============================================================

/* ============================================================
   ACCURACY ASSESSMENT — GODAVARI LULC 2016
   STEP 1: GENERATE CANDIDATE REFERENCE POINTS
   ============================================================ */

// Use the existing lulc2016 and basin variables.

// Generate 30 candidate points per mapped class.
// These are NOT yet verified reference labels.


/* ACCURACY ASSESSMENT — 2016
   Faster candidate point generation */

var samples2016 = lulc2016.stratifiedSample({
  numPoints: 30,
  classBand: "LULC",
  region: basin.geometry(),
  scale: 100,
  seed: 2016,
  geometries: true,
  dropNulls: true,
  tileScale: 8
});

print("2016 candidate sample count:", samples2016.size());
print("2016 candidate points:", samples2016.limit(10));

Map.addLayer(
  samples2016,
  {color: "yellow"},
  "2016 Candidate Accuracy Points"
);

Export.table.toDrive({
  collection: samples2016,
  description: "Godavari_LULC_2016_Candidate_Points",
  folder: "Godavari_LULC",
  fileNamePrefix: "Godavari_LULC_2016_Candidate_Points",
  fileFormat: "CSV"
});

/* ============================================================
   GODAVARI LULC 2016 — REFERENCE EVIDENCE
   Same workflow as 2021
   ============================================================ */

// 1. LOAD ESA WORLDCOVER 2021
// This is a candidate comparison layer, NOT 2016 ground truth.

var esa2021 = ee.ImageCollection("ESA/WorldCover/v200")
  .first()
  .select("Map")
  .clip(basin);

// Convert ESA classes to project classes:
// 0 Water, 1 Forest, 2 Agriculture,
// 3 Built-up, 4 Barren, 5 Grassland/Wasteland

var esaCandidate2016 = esa2021.remap(
  [10, 20, 30, 40, 50, 60, 80, 90, 95, 100],
  [ 1,  5,  5,  2,  3,  4,  0,  5,  5,   5],
  -1
).rename("ESA_candidate");

// 2. LOAD 2016 SENTINEL-2 IMAGERY
// Use TOA imagery because Sentinel-2 SR Harmonized
// does not cover the full 2016 calendar year.

var s2_2016 = ee.ImageCollection("COPERNICUS/S2_HARMONIZED")
  .filterBounds(basin)
  .filterDate("2016-01-01", "2017-01-01")
  .filter(ee.Filter.lt("CLOUDY_PIXEL_PERCENTAGE", 30))
  .select(["B2", "B3", "B4", "B8"]);

print("2016 Sentinel-2 image count:", s2_2016.size());

var s2Median2016 = s2_2016.median().clip(basin);

var ndvi2016 = s2Median2016.normalizedDifference(
  ["B8", "B4"]
).rename("NDVI");

var ndwi2016 = s2Median2016.normalizedDifference(
  ["B3", "B8"]
).rename("NDWI");

// 3. COMBINE MAP, ESA CANDIDATE AND SATELLITE EVIDENCE

var evidenceImage2016 = lulc2016.rename("Predicted")
  .addBands(esaCandidate2016)
  .addBands(s2Median2016)
  .addBands(ndvi2016)
  .addBands(ndwi2016);

// Sample evidence at the 180 candidate points.
var evidence2016 = evidenceImage2016.sampleRegions({
  collection: samples2016,
  properties: ["LULC"],
  scale: 10,
  geometries: true,
  tileScale: 4
});

// 4. FLAG POINTS THAT DISAGREE WITH ESA CANDIDATE

var flagged2016 = evidence2016.map(function(feature) {
  var predicted = ee.Number(feature.get("Predicted"));
  var esa = ee.Number(feature.get("ESA_candidate"));

  var needsReview = esa.gte(0)
    .and(esa.neq(predicted));

  return feature.set({
    "Year": 2016,
    "needs_review": needsReview,
    "review_status": ee.Algorithms.If(
      esa.lt(0),
      "Needs reference",
      ee.Algorithms.If(
        needsReview,
        "Flagged for review",
        "Candidate agreement - not verified"
      )
    )
  });
});

print("2016 evidence rows:", flagged2016.size());
print(
  "2016 points flagged for review:",
  flagged2016.filter(
    ee.Filter.eq("needs_review", true)
  ).size()
);

// 5. EXPORT ALL POINTS WITH EVIDENCE

Export.table.toDrive({
  collection: flagged2016,
  description: "Godavari_2016_All180_Evidence_Combined",
  folder: "Godavari_LULC",
  fileNamePrefix: "Godavari_2016_All180_Evidence_Combined",
  fileFormat: "CSV"
});

// 6. EXPORT FLAGGED POINTS SEPARATELY

Export.table.toDrive({
  collection: flagged2016.filter(
    ee.Filter.eq("needs_review", true)
  ),
  description: "Godavari_2016_Priority_Review",
  folder: "Godavari_LULC",
  fileNamePrefix: "Godavari_2016_Priority_Review",
  fileFormat: "CSV"
});

// ============================================================
// END 2016 EVIDENCE SECTION
// ============================================================

/* ============================================================
   6. HISTORICAL LULC AREA STATISTICS — 2016
   Area in hectares and square kilometres
   ============================================================ */

// Class information
var classIDs = [0, 1, 2, 3, 4, 5];

var classNames = [
  "Water",
  "Forest",
  "Agriculture",
  "Built-up",
  "Barren",
  "Grassland_Wasteland"
];

// Calculate pixel area
var areaImage2016 = ee.Image.pixelArea()
  .rename("area")
  .addBands(lulc2016.rename("class"));

// Calculate area grouped by class
var areaResult2016 = areaImage2016.reduceRegion({
  reducer: ee.Reducer.sum().group({
    groupField: 1,
    groupName: "class"
  }),
  geometry: basin.geometry(),
  scale: 100,
  maxPixels: 1e13,
  tileScale: 4
});

var areaGroups2016 = ee.List(
  areaResult2016.get("groups")
);

// Create a feature for each of the six classes
var areaFeatures2016 = ee.FeatureCollection(
  classIDs.map(function(classID) {

    var matchingGroup = areaGroups2016.filter(
      ee.Filter.eq("class", classID)
    );

    var areaM2 = ee.Number(
      ee.Algorithms.If(
        matchingGroup.size().gt(0),
        ee.Dictionary(matchingGroup.get(0)).get("sum"),
        0
      )
    );

    var areaHa = areaM2.divide(10000);
    var areaKm2 = areaM2.divide(1000000);

    return ee.Feature(null, {
      Year: 2016,
      Class_ID: classID,
      LULC_Class: classNames[classID],
      Area_ha: areaHa,
      Area_km2: areaKm2
    });
  })
);

print("2016 LULC Area Statistics:", areaFeatures2016);

print(
  "2016 Total Classified Area (km²):",
  areaFeatures2016.aggregate_sum("Area_km2")
);

// Export area statistics as a separate CSV
Export.table.toDrive({
  collection: areaFeatures2016,
  description: "Godavari_LULC_2016_Area_Statistics",
  folder: "Godavari_LULC",
  fileNamePrefix: "Godavari_LULC_2016_Area_Statistics",
  fileFormat: "CSV"
});
