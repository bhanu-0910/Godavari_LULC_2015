// ============================================================
// GODAVARI BASIN - LULC 2016
// Dynamic World
// Training will be done later
// ============================================================


// 1. LOAD GODAVARI BASIN

var basin = ee.FeatureCollection(
  "projects/fine-slice-478618-n5/assets/Godavari_Basin"
);

Map.centerObject(basin, 7);

Map.addLayer(
  basin.style({
    color: "red",
    fillColor: "00000000",
    width: 2
  }),
  {},
  "Godavari Basin"
);


// 2. LOAD DYNAMIC WORLD 2016

var dwCollection2016 = ee.ImageCollection(
  "GOOGLE/DYNAMICWORLD/V1"
)
  .filterBounds(basin)
  .filterDate("2016-01-01", "2017-01-01");

print("2016 Dynamic World image count:",
      dwCollection2016.size());

var dw2016 = dwCollection2016
  .select("label")
  .mode()
  .clip(basin);

print("Dynamic World 2016:", dw2016);


// 3. PRINT INFORMATION

print("Dynamic World 2016:", dw2016);


// 4. DISPLAY ORIGINAL DYNAMIC WORLD

var dwPalette = [
  "419BDF", // Water
  "397D49", // Trees
  "88B053", // Grass
  "7A87C6", // Flooded vegetation
  "E49635", // Crops
  "DFC35A", // Shrub
  "C4281B", // Built
  "A59B8F", // Bare
  "B39FE1"  // Snow/Ice
];

Map.addLayer(
  dw2016,
  {
    min: 0,
    max: 8,
    palette: dwPalette
  },
  "Dynamic World 2016"
);


// 5. CONVERT TO OUR 6 PROJECT CLASSES

// 0 = Water
// 1 = Forest
// 2 = Agriculture
// 3 = Built-up
// 4 = Barren
// 5 = Grassland/Wasteland

var lulc2016 = ee.Image(0)
  .where(dw2016.eq(0), 0)  // Water
  .where(dw2016.eq(1), 1)  // Trees → Forest
  .where(dw2016.eq(2), 5)  // Grass → Grassland
  .where(dw2016.eq(3), 0)  // Flooded vegetation → Water
  .where(dw2016.eq(4), 2)  // Crops → Agriculture
  .where(dw2016.eq(5), 5)  // Shrub → Grassland
  .where(dw2016.eq(6), 3)  // Built → Built-up
  .where(dw2016.eq(7), 4)  // Bare → Barren
  .where(dw2016.eq(8), 4)  // Snow/Ice → Barren
  .rename("LULC")
  .clip(basin);


// 6. DISPLAY 6-CLASS LULC

var lulcPalette = [
  "419BDF", // Water
  "397D49", // Forest
  "E49635", // Agriculture
  "C4281B", // Built-up
  "A59B8F", // Barren
  "88B053"  // Grassland/Wasteland
];

Map.addLayer(
  lulc2016,
  {
    min: 0,
    max: 5,
    palette: lulcPalette
  },
  "Godavari LULC 2016"
);


// 7. CALCULATE AREA

// 7. CALCULATE AREA — 10 m scale

var areaImage = ee.Image.pixelArea()
  .divide(10000)
  .rename("area_ha")
  .addBands(lulc2016.rename("class"));

var area2016 = areaImage.reduceRegion({
  reducer: ee.Reducer.sum().group({
    groupField: 1,
    groupName: "class"
  }),
  geometry: basin.geometry(),
  scale: 10,
  maxPixels: 1e13,
  tileScale: 4
});

print("2016 LULC area (hectares):", area2016);

var classifiedArea = ee.Image.pixelArea()
  .updateMask(lulc2016.mask())
  .divide(1e6)
  .rename("area_km2")
  .reduceRegion({
    reducer: ee.Reducer.sum(),
    geometry: basin.geometry(),
    scale: 10,
    maxPixels: 1e13,
    tileScale: 4
  });

print("2016 total classified area (km²):", classifiedArea);

// 8. CLASS INFORMATION

print(
  "Classes:",
  "0 Water | 1 Forest | 2 Agriculture | " +
  "3 Built-up | 4 Barren | 5 Grassland/Wasteland"
);


// 9. EXPORT 2016 LULC

Export.image.toDrive({

  image: lulc2016.toByte(),

  description: "Godavari_LULC_2016",

  folder: "Godavari_LULC",

  fileNamePrefix: "Godavari_LULC_2016",

  region: basin.geometry(),

  scale: 10,

  maxPixels: 1e13

});


