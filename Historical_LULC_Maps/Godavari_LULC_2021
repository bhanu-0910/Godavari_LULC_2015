
 // ============================================================
 // GODAVARI BASIN - LULC 2021
 // Dynamic World
 // Training will be done later
 // ============================================================


// 1. LOAD GODAVARI BASIN

var basin = ee.FeatureCollection(
  "projects/fine-slice-478618-n5/assets/Godavari_Basin"
);

Map.centerObject(basin, 7);

Map.addLayer(
  basin.style({
    color: "red",
    fillColor: "00000000",
    width: 2
  }),
  {},
  "Godavari Basin"
);


// 2. LOAD DYNAMIC WORLD 2021

var dw2021 = ee.ImageCollection(
  "GOOGLE/DYNAMICWORLD/V1"
)
  .filterBounds(basin)
  .filterDate("2021-01-01", "2022-01-01")
  .select("label")
  .mode()
  .clip(basin);


// 3. PRINT INFORMATION

print("Dynamic World 2021:", dw2021);


// 4. CONVERT TO OUR 6 PROJECT CLASSES

// 0 = Water
// 1 = Forest
// 2 = Agriculture
// 3 = Built-up
// 4 = Barren
// 5 = Grassland/Wasteland

var lulc2021 = ee.Image(0)
  .where(dw2021.eq(0), 0)  // Water
  .where(dw2021.eq(1), 1)  // Trees → Forest
  .where(dw2021.eq(2), 5)  // Grass → Grassland
  .where(dw2021.eq(3), 0)  // Flooded vegetation → Water
  .where(dw2021.eq(4), 2)  // Crops → Agriculture
  .where(dw2021.eq(5), 5)  // Shrub → Grassland
  .where(dw2021.eq(6), 3)  // Built → Built-up
  .where(dw2021.eq(7), 4)  // Bare → Barren
  .where(dw2021.eq(8), 4)  // Snow/Ice → Barren
  .rename("LULC")
  .clip(basin);


// 5. DISPLAY 6-CLASS LULC

var lulcPalette = [
  "419BDF", // Water
  "397D49", // Forest
  "E49635", // Agriculture
  "C4281B", // Built-up
  "A59B8F", // Barren
  "88B053"  // Grassland/Wasteland
];

Map.addLayer(
  lulc2021,
  {
    min: 0,
    max: 5,
    palette: lulcPalette
  },
  "Godavari LULC 2021"
);


// 6. CALCULATE AREA

var areaImage = ee.Image.pixelArea()
  .divide(10000)
  .addBands(lulc2021);

var area2021 = areaImage.reduceRegion({

  reducer: ee.Reducer.sum()
    .group({
      groupField: 1,
      groupName: "class"
    }),

  geometry: basin.geometry(),

  scale: 100,

  bestEffort: true,

  maxPixels: 1e13,

  tileScale: 4
});

print(
  "2021 LULC Area (hectares):",
  area2021
);


// 7. CLASS INFORMATION

print(
  "Classes:",
  "0 Water | 1 Forest | 2 Agriculture | " +
  "3 Built-up | 4 Barren | 5 Grassland/Wasteland"
);


// 8. EXPORT 2021 LULC

Export.image.toDrive({

  image: lulc2021.toByte(),

  description: "Godavari_LULC_2021",

  folder: "Godavari_LULC",

  fileNamePrefix: "Godavari_LULC_2021",

  region: basin.geometry(),

  scale: 10,

  maxPixels: 1e13

});


// ============================================================
// END
// ============================================================

/***************************************************************
 STEP 9 — SAMPLE LULC AND BUILD PRELIMINARY CONFUSION MATRIX
***************************************************************/

var samples = ee.FeatureCollection(
  "projects/fine-slice-478618-n5/assets/Godavari_LULC_2021_Samples"
);

// Extract predicted class from the 2021 map.
var predicted = lulc2021.rename("predicted");

var validation = predicted.sampleRegions({
  collection: samples,
  properties: ["LULC"],
  scale: 10,
  geometries: true,
  tileScale: 4
});

// Rename the sample's LULC field to reference.
// IMPORTANT: This is valid only if the sample labels are
// independent, verified reference labels.
validation = validation.map(function(feature) {
  return feature.set("reference", feature.get("LULC"));
});

print("Validation sample count:", validation.size());
print("Validation feature:", validation.first());
print("Validation property names:", validation.first().propertyNames());

// Count sample labels by class.
var referenceCounts = validation.aggregate_histogram("reference");
var predictedCounts = validation.aggregate_histogram("predicted");

print("Reference label counts:", referenceCounts);
print("Predicted class counts:", predictedCounts);

// Confusion matrix: rows = reference, columns = predicted.
var matrix = validation.errorMatrix(
  "reference",
  "predicted",
  [0, 1, 2, 3, 4, 5]
);

print("Confusion matrix (PRELIMINARY):", matrix);
print("Overall accuracy (PRELIMINARY):", matrix.accuracy());
print("Producer's accuracy (PRELIMINARY):", matrix.producersAccuracy());
print("User's accuracy (PRELIMINARY):", matrix.consumersAccuracy());
print("Kappa (PRELIMINARY):", matrix.kappa());

/***************************************************************
 END STEP 9
***************************************************************/

/***************************************************************
 STEP 10 — 2021 REFERENCE LABEL INSPECTION
 Sentinel-2 imagery + existing sample points
***************************************************************/

var samples = ee.FeatureCollection(
  "projects/fine-slice-478618-n5/assets/Godavari_LULC_2021_Samples"
);

// Sentinel-2 surface reflectance imagery for 2021.
var s2 = ee.ImageCollection("COPERNICUS/S2_SR_HARMONIZED")
  .filterBounds(basin)
  .filterDate("2021-01-01", "2022-01-01")
  .filter(ee.Filter.lt("CLOUDY_PIXEL_PERCENTAGE", 30));

print("Sentinel-2 scenes available in 2021:", s2.size());

// Cloud and cirrus masking using the scene classification band.
function maskS2(image) {
  var scl = image.select("SCL");
  var clear = scl.neq(3)  // Cloud shadow
    .and(scl.neq(8))      // Medium-probability cloud
    .and(scl.neq(9))      // High-probability cloud
    .and(scl.neq(10))     // Cirrus
    .and(scl.neq(11));    // Snow/ice

  return image.updateMask(clear)
    .select(["B2", "B3", "B4", "B8"])
    .copyProperties(image, ["system:time_start"]);
}

// Median composite: useful for overview, but inspect dates
// and seasonal changes when deciding reference labels.
var s2Composite = s2
  .map(maskS2)
  .median()
  .clip(basin);

Map.addLayer(
  s2Composite,
  {bands: ["B4", "B3", "B2"], min: 0, max: 3000},
  "2021 Sentinel-2 RGB"
);

Map.addLayer(
  s2Composite,
  {bands: ["B8", "B4", "B3"], min: 0, max: 4000},
  "2021 Sentinel-2 False Colour",
  false
);

// Show sample points on top of imagery.
Map.addLayer(
  samples,
  {color: "yellow"},
  "2021 Reference Samples"
);

print("Sample count:", samples.size());
print("Sample properties:", samples.first());

