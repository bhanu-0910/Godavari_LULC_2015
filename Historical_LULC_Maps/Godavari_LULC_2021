
 // ============================================================
 // GODAVARI BASIN - LULC 2021
 // Dynamic World
 // Training will be done later
 // ============================================================


// 1. LOAD GODAVARI BASIN

var basin = ee.FeatureCollection(
  "projects/fine-slice-478618-n5/assets/Godavari_Basin"
);

Map.centerObject(basin, 7);

Map.addLayer(
  basin.style({
    color: "red",
    fillColor: "00000000",
    width: 2
  }),
  {},
  "Godavari Basin"
);


// 2. LOAD DYNAMIC WORLD 2021

var dw2021 = ee.ImageCollection(
  "GOOGLE/DYNAMICWORLD/V1"
)
  .filterBounds(basin)
  .filterDate("2021-01-01", "2022-01-01")
  .select("label")
  .mode()
  .clip(basin);


// 3. PRINT INFORMATION

print("Dynamic World 2021:", dw2021);


// 4. CONVERT TO OUR 6 PROJECT CLASSES

// 0 = Water
// 1 = Forest
// 2 = Agriculture
// 3 = Built-up
// 4 = Barren
// 5 = Grassland/Wasteland

var lulc2021 = ee.Image(0)
  .where(dw2021.eq(0), 0)  // Water
  .where(dw2021.eq(1), 1)  // Trees → Forest
  .where(dw2021.eq(2), 5)  // Grass → Grassland
  .where(dw2021.eq(3), 0)  // Flooded vegetation → Water
  .where(dw2021.eq(4), 2)  // Crops → Agriculture
  .where(dw2021.eq(5), 5)  // Shrub → Grassland
  .where(dw2021.eq(6), 3)  // Built → Built-up
  .where(dw2021.eq(7), 4)  // Bare → Barren
  .where(dw2021.eq(8), 4)  // Snow/Ice → Barren
  .rename("LULC")
  .clip(basin);


// 5. DISPLAY 6-CLASS LULC

var lulcPalette = [
  "419BDF", // Water
  "397D49", // Forest
  "E49635", // Agriculture
  "C4281B", // Built-up
  "A59B8F", // Barren
  "88B053"  // Grassland/Wasteland
];

Map.addLayer(
  lulc2021,
  {
    min: 0,
    max: 5,
    palette: lulcPalette
  },
  "Godavari LULC 2021"
);


// 6. CALCULATE AREA

var areaImage = ee.Image.pixelArea()
  .divide(10000)
  .addBands(lulc2021);

var area2021 = areaImage.reduceRegion({

  reducer: ee.Reducer.sum()
    .group({
      groupField: 1,
      groupName: "class"
    }),

  geometry: basin.geometry(),

  scale: 100,

  bestEffort: true,

  maxPixels: 1e13,

  tileScale: 4
});

print(
  "2021 LULC Area (hectares):",
  area2021
);


// 7. CLASS INFORMATION

print(
  "Classes:",
  "0 Water | 1 Forest | 2 Agriculture | " +
  "3 Built-up | 4 Barren | 5 Grassland/Wasteland"
);


// 8. EXPORT 2021 LULC

Export.image.toDrive({

  image: lulc2021.toByte(),

  description: "Godavari_LULC_2021",

  folder: "Godavari_LULC",

  fileNamePrefix: "Godavari_LULC_2021",

  region: basin.geometry(),

  scale: 10,

  maxPixels: 1e13

});


// ============================================================
// END
// ============================================================

/***************************************************************
 STEP 9 — SAMPLE LULC AND BUILD PRELIMINARY CONFUSION MATRIX
***************************************************************/

var samples = ee.FeatureCollection(
  "projects/fine-slice-478618-n5/assets/Godavari_LULC_2021_Samples"
);

// Extract predicted class from the 2021 map.
var predicted = lulc2021.rename("predicted");

var validation = predicted.sampleRegions({
  collection: samples,
  properties: ["LULC"],
  scale: 10,
  geometries: true,
  tileScale: 4
});

// Rename the sample's LULC field to reference.
// IMPORTANT: This is valid only if the sample labels are
// independent, verified reference labels.
validation = validation.map(function(feature) {
  return feature.set("reference", feature.get("LULC"));
});

//print("Validation sample count:", validation.size());
//print("Validation property names:", validation.first().propertyNames());

// Count sample labels by class.
var referenceCounts = validation.aggregate_histogram("reference");
var predictedCounts = validation.aggregate_histogram("predicted");

print("Reference label counts:", referenceCounts);
print("Predicted class counts:", predictedCounts);

// Confusion matrix: rows = reference, columns = predicted.
var matrix = validation.errorMatrix(
  "reference",
  "predicted",
  [0, 1, 2, 3, 4, 5]
);

print("Confusion matrix (PRELIMINARY):", matrix);
print("Overall accuracy (PRELIMINARY):", matrix.accuracy());
print("Producer's accuracy (PRELIMINARY):", matrix.producersAccuracy());
print("User's accuracy (PRELIMINARY):", matrix.consumersAccuracy());
print("Kappa (PRELIMINARY):", matrix.kappa());

/***************************************************************
 END STEP 9
***************************************************************/



/***************************************************************
 STEP 10 — LOAD REFERENCE DATA FOR ALL 180 SAMPLES
***************************************************************/

var samples = ee.FeatureCollection(
  "projects/fine-slice-478618-n5/assets/Godavari_LULC_2021_Samples"
);

// ESA WorldCover 2021: independent land-cover product.
var esa = ee.ImageCollection("ESA/WorldCover/v200")
  .first()
  .select("Map")
  .rename("ESA_class");

// Sample ESA and Dynamic World-derived project classes
// at each of the existing 180 points.
var sampled = esa.addBands(
  lulc2021.rename("predicted_LULC")
).sampleRegions({
  collection: samples,
  properties: ["LULC"],
  scale: 10,
  geometries: true,
  tileScale: 4
});

/***************************************************************
 STEP 11 — CREATE PROVISIONAL REFERENCE-LABEL CANDIDATES
***************************************************************/

// Map ESA WorldCover classes to the six project classes.
// -1 = needs review / unsupported mapping.
var candidates = sampled.map(function(f) {
  var e = ee.Number(f.get("ESA_class"));

  var candidate = ee.Algorithms.If(
    e.eq(80), 0,  // Water
    ee.Algorithms.If(
      e.eq(10), 1,  // Tree cover
      ee.Algorithms.If(
        e.eq(40), 2,  // Cropland
        ee.Algorithms.If(
          e.eq(50), 3,  // Built-up
          ee.Algorithms.If(
            e.eq(60), 4,  // Bare / sparse vegetation
            ee.Algorithms.If(
              e.eq(30).or(e.eq(20)).or(e.eq(90))
                .or(e.eq(95)).or(e.eq(100)),
              5,  // Grass, shrub, wetland, mangrove, moss/lichen
              -1
            )
          )
        )
      )
    )
  );

  return f.set({
    "reference_candidate": candidate,
    "final_reference": -1,
    "verification_status": "Pending independent verification"
  });
});

print("Existing samples:", samples.size());
print("Candidate records:", candidates.size());
print("Example candidate:", candidates.first());
print(
  "Candidate class counts:",
  candidates.aggregate_histogram("reference_candidate")
);

/***************************************************************
 STEP 12 — EXPORT CANDIDATES FOR REVIEW
***************************************************************/

Export.table.toDrive({
  collection: candidates,
  description: "Godavari_2021_Reference_Candidates",
  folder: "Godavari_LULC",
  fileNamePrefix: "Godavari_2021_Reference_Candidates",
  fileFormat: "CSV",
  selectors: [
    "LULC",
    "ESA_class",
    "predicted_LULC",
    "reference_candidate",
    "final_reference",
    "verification_status",
    ".geo"
  ]
});

/***************************************************************
 END STEP 10–12
***************************************************************/

var samples = ee.FeatureCollection(
  "projects/fine-slice-478618-n5/assets/Godavari_LULC_2021_Samples"
);

var esa = ee.ImageCollection("ESA/WorldCover/v200")
  .first()
  .select("Map")
  .rename("ESA_class");

var comparison = esa.addBands(
  lulc2021.rename("predicted_LULC")
).sampleRegions({
  collection: samples,
  properties: ["LULC"],
  scale: 10,
  geometries: true,
  tileScale: 4
}).map(function(f) {
  var e = ee.Number(f.get("ESA_class"));

  var candidate = ee.Number(ee.Algorithms.If(
    e.eq(80), 0,
    ee.Algorithms.If(e.eq(10), 1,
    ee.Algorithms.If(e.eq(40), 2,
    ee.Algorithms.If(e.eq(50), 3,
    ee.Algorithms.If(e.eq(60), 4,
    ee.Algorithms.If(
      e.eq(20).or(e.eq(30)).or(e.eq(90))
       .or(e.eq(95)).or(e.eq(100)), 5, -1
    )))))
  ));

  var predicted = ee.Number(f.get("predicted_LULC"));

  return f.set({
    reference_candidate: candidate,
    needs_review: ee.Number(candidate).neq(predicted)
  });
});
print("Review status counts:",
  comparison.aggregate_histogram("needs_review"));

print("First comparison record:", comparison.first());

print("Total samples", comparison.size());
print("Samples needing review",
  comparison.filter(ee.Filter.eq("needs_review", true)).size());
print("Candidate vs prediction counts",
  comparison.aggregate_histogram("reference_candidate"));
  var needsReview = comparison.filter(
  ee.Filter.eq("needs_review", 1)
);

print("Correct review count:", needsReview.size());

Export.table.toDrive({
  collection: needsReview,
  description: "Godavari_2021_Samples_Needing_Review",
  folder: "Godavari_LULC",
  fileNamePrefix: "Godavari_2021_Samples_Needing_Review",
  fileFormat: "CSV"
});

var reviewPoints = ee.FeatureCollection(
  "projects/fine-slice-478618-n5/assets/Godavari_LULC_2021_Samples"
);

var esa2021 = ee.ImageCollection("ESA/WorldCover/v200")
  .first()
  .select("Map");

var reviewComparison = esa2021
  .addBands(lulc2021.rename("predicted_LULC"))
  .sampleRegions({
    collection: reviewPoints,
    properties: ["LULC"],
    scale: 10,
    geometries: true,
    tileScale: 4
  })
  .map(function(f) {
    var e = ee.Number(f.get("Map"));
    var candidate = ee.Number(ee.Algorithms.If(
      e.eq(80), 0,
      ee.Algorithms.If(e.eq(10), 1,
      ee.Algorithms.If(e.eq(40), 2,
      ee.Algorithms.If(e.eq(50), 3,
      ee.Algorithms.If(e.eq(60), 4,
      ee.Algorithms.If(
        e.eq(20).or(e.eq(30)).or(e.eq(90))
          .or(e.eq(95)).or(e.eq(100)), 5, -1
      )))))
    ));

    return f.set(
      "needs_review",
      candidate.neq(ee.Number(f.get("predicted_LULC")))
    );
  })
  .filter(ee.Filter.eq("needs_review", 1));

Map.addLayer(
  reviewComparison,
  {color: "yellow"},
  "64 Points to Review"
);

Map.centerObject(reviewComparison, 9);

print("Review points:", reviewComparison.size());

Export.table.toDrive({
  collection: reviewComparison,
  description: "Godavari_2021_64_Review_Points",
  folder: "Godavari_LULC",
  fileNamePrefix: "Godavari_2021_64_Review_Points",
  fileFormat: "CSV",
  selectors: [
    "LULC",
    "Map",
    "predicted_LULC",
    "needs_review",
    ".geo"
  ]
});

