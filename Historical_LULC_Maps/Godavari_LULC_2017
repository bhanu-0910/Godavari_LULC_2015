// ============================================================
// GODAVARI BASIN - LULC 2017
// Dynamic World
// Training will be done later
// ============================================================


// 1. LOAD GODAVARI BASIN

var basin = ee.FeatureCollection(
  "projects/fine-slice-478618-n5/assets/Godavari_Basin"
);

Map.centerObject(basin, 7);

Map.addLayer(
  basin.style({
    color: "red",
    fillColor: "00000000",
    width: 2
  }),
  {},
  "Godavari Basin"
);


// 2. LOAD DYNAMIC WORLD 2017

var dw2017 = ee.ImageCollection(
  "GOOGLE/DYNAMICWORLD/V1"
)
  .filterBounds(basin)
  .filterDate("2017-01-01", "2018-01-01")
  .select("label")
  .mode()
  .clip(basin);


// 3. PRINT INFORMATION

print("Dynamic World 2017:", dw2017);


// ============================================================
// 4. CONVERT TO OUR 6 PROJECT CLASSES
// ============================================================
//
// 0 = Water
// 1 = Forest
// 2 = Agriculture
// 3 = Built-up
// 4 = Barren
// 5 = Grassland/Wasteland
//
// Dynamic World:
// 0 = Water
// 1 = Trees
// 2 = Grass
// 3 = Flooded vegetation
// 4 = Crops
// 5 = Shrub and scrub
// 6 = Built
// 7 = Bare
// 8 = Snow/Ice
// ============================================================

var lulc2017 = ee.Image(0)
  .where(dw2017.eq(0), 0)  // Water
  .where(dw2017.eq(1), 1)  // Trees → Forest
  .where(dw2017.eq(2), 5)  // Grass → Grassland
  .where(dw2017.eq(3), 0)  // Flooded vegetation → Water
  .where(dw2017.eq(4), 2)  // Crops → Agriculture
  .where(dw2017.eq(5), 5)  // Shrub → Grassland
  .where(dw2017.eq(6), 3)  // Built → Built-up
  .where(dw2017.eq(7), 4)  // Bare → Barren
  .where(dw2017.eq(8), 4)  // Snow/Ice → Barren
  .rename("LULC")
  .clip(basin);


// ============================================================
// 5. DISPLAY 6-CLASS LULC
// ============================================================

var lulcPalette = [
  "419BDF", // Water
  "397D49", // Forest
  "E49635", // Agriculture
  "C4281B", // Built-up
  "A59B8F", // Barren
  "88B053"  // Grassland/Wasteland
];

Map.addLayer(
  lulc2017,
  {
    min: 0,
    max: 5,
    palette: lulcPalette
  },
  "Godavari LULC 2017"
);


// ============================================================
// 6. CALCULATE AREA
// ============================================================

var areaImage = ee.Image.pixelArea()
  .divide(10000)
  .addBands(lulc2017);

var area2017 = areaImage.reduceRegion({

  reducer: ee.Reducer.sum()
    .group({
      groupField: 1,
      groupName: "class"
    }),

  geometry: basin.geometry(),

  scale: 100,

  bestEffort: true,

  maxPixels: 1e13,

  tileScale: 4
});

print(
  "2017 LULC Area (hectares):",
  area2017
);


// ============================================================
// 7. CLASS INFORMATION
// ============================================================

print(
  "Classes:",
  "0 Water | 1 Forest | 2 Agriculture | " +
  "3 Built-up | 4 Barren | 5 Grassland/Wasteland"
);


// ============================================================
// 8. EXPORT 2017 LULC
// ============================================================

Export.image.toDrive({

  image: lulc2017.toByte(),

  description: "Godavari_LULC_2017",

  folder: "Godavari_LULC",

  fileNamePrefix: "Godavari_LULC_2017",

  region: basin.geometry(),

  scale: 10,

  maxPixels: 1e13

});


// ============================================================
// END
// ============================================================

/* ============================================================
   9. HISTORICAL LULC AREA STATISTICS — 2017
   ============================================================ */

var classIDs2017 = [0, 1, 2, 3, 4, 5];

var classNames2017 = [
  "Water",
  "Forest",
  "Agriculture",
  "Built-up",
  "Barren",
  "Grassland_Wasteland"
];

// Calculate pixel area in square metres
var areaImage2017 = ee.Image.pixelArea()
  .rename("area")
  .addBands(lulc2017.rename("class"));

// Group area by class
var areaResult2017 = areaImage2017.reduceRegion({
  reducer: ee.Reducer.sum().group({
    groupField: 1,
    groupName: "class"
  }),
  geometry: basin.geometry(),
  scale: 100,
  maxPixels: 1e13,
  tileScale: 4
});

var areaGroups2017 = ee.List(
  areaResult2017.get("groups")
);

// Convert grouped results into a dictionary
var areaDictionary2017 = ee.Dictionary(
  areaGroups2017.iterate(function(item, accumulator) {

    item = ee.Dictionary(item);

    var classID = ee.Number(item.get("class"));
    var areaM2 = ee.Number(item.get("sum"));

    return ee.Dictionary(accumulator).set(
      classID.format(),
      areaM2
    );

  }, ee.Dictionary({}))
);

// Create six class records
var areaFeatures2017 = ee.FeatureCollection(
  classIDs2017.map(function(classID) {

    var areaM2 = ee.Number(
      areaDictionary2017.get(
        ee.Number(classID).format(),
        0
      )
    );

    return ee.Feature(null, {
      Year: 2017,
      Class_ID: classID,
      LULC_Class: classNames2017[classID],
      Area_ha: areaM2.divide(10000),
      Area_km2: areaM2.divide(1000000)
    });

  })
);

print("2017 LULC Area Statistics:", areaFeatures2017);

print(
  "2017 Total Classified Area (km²):",
  areaFeatures2017.aggregate_sum("Area_km2")
);

// Export CSV
Export.table.toDrive({
  collection: areaFeatures2017,
  description: "Godavari_LULC_2017_Area_Statistics",
  folder: "Godavari_LULC",
  fileNamePrefix: "Godavari_LULC_2017_Area_Statistics",
  fileFormat: "CSV"
});

// ============================================================
// END AREA STATISTICS
// ============================================================
