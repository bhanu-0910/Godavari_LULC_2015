// ============================================================
// GODAVARI BASIN - LULC 2019
// Dynamic World
// Training will be done later
// ============================================================


// 1. LOAD GODAVARI BASIN

var basin = ee.FeatureCollection(
  "projects/fine-slice-478618-n5/assets/Godavari_Basin"
);

Map.centerObject(basin, 7);

Map.addLayer(
  basin.style({
    color: "red",
    fillColor: "00000000",
    width: 2
  }),
  {},
  "Godavari Basin"
);


// 2. LOAD DYNAMIC WORLD 2019

var dw2019 = ee.ImageCollection(
  "GOOGLE/DYNAMICWORLD/V1"
)
  .filterBounds(basin)
  .filterDate("2019-01-01", "2020-01-01")
  .select("label")
  .mode()
  .clip(basin);


// 3. PRINT INFORMATION

print("Dynamic World 2019:", dw2019);


// 4. CONVERT TO OUR 6 PROJECT CLASSES

// 0 = Water
// 1 = Forest
// 2 = Agriculture
// 3 = Built-up
// 4 = Barren
// 5 = Grassland/Wasteland

var lulc2019 = ee.Image(0)
  .where(dw2019.eq(0), 0)  // Water
  .where(dw2019.eq(1), 1)  // Trees → Forest
  .where(dw2019.eq(2), 5)  // Grass → Grassland
  .where(dw2019.eq(3), 0)  // Flooded vegetation → Water
  .where(dw2019.eq(4), 2)  // Crops → Agriculture
  .where(dw2019.eq(5), 5)  // Shrub → Grassland
  .where(dw2019.eq(6), 3)  // Built → Built-up
  .where(dw2019.eq(7), 4)  // Bare → Barren
  .where(dw2019.eq(8), 4)  // Snow/Ice → Barren
  .rename("LULC")
  .clip(basin);


// 5. DISPLAY 6-CLASS LULC

var lulcPalette = [
  "419BDF", // Water
  "397D49", // Forest
  "E49635", // Agriculture
  "C4281B", // Built-up
  "A59B8F", // Barren
  "88B053"  // Grassland/Wasteland
];

Map.addLayer(
  lulc2019,
  {
    min: 0,
    max: 5,
    palette: lulcPalette
  },
  "Godavari LULC 2019"
);


// 6. CALCULATE AREA

var areaImage = ee.Image.pixelArea()
  .divide(10000)
  .addBands(lulc2019);

var area2019 = areaImage.reduceRegion({

  reducer: ee.Reducer.sum()
    .group({
      groupField: 1,
      groupName: "class"
    }),

  geometry: basin.geometry(),

  scale: 100,

  bestEffort: true,

  maxPixels: 1e13,

  tileScale: 4
});

print(
  "2019 LULC Area (hectares):",
  area2019
);


// 7. CLASS INFORMATION

print(
  "Classes:",
  "0 Water | 1 Forest | 2 Agriculture | " +
  "3 Built-up | 4 Barren | 5 Grassland/Wasteland"
);


// 8. EXPORT 2019 LULC

Export.image.toDrive({

  image: lulc2019.toByte(),

  description: "Godavari_LULC_2019",

  folder: "Godavari_LULC",

  fileNamePrefix: "Godavari_LULC_2019",

  region: basin.geometry(),

  scale: 10,

  maxPixels: 1e13

});

// ==========================================
// GODAVARI BASIN - 2019 SENTINEL-2 EVIDENCE
// ==========================================

// Load Sentinel-2 imagery
var s2 = ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED')
  .filterBounds(basin)
  .filterDate('2019-01-01', '2020-01-01')
  .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 30));

// Create median composite
var composite = s2.median().clip(basin);

// Calculate NDVI and NDWI
var ndvi = composite.normalizedDifference(['B8', 'B4'])
  .rename('NDVI');

var ndwi = composite.normalizedDifference(['B3', 'B8'])
  .rename('NDWI');

// Combine bands and indices
var evidenceImage = composite
  .select(['B2', 'B3', 'B4', 'B8'])
  .addBands(ndvi)
  .addBands(ndwi);

// Extract values at candidate points
var evidence = evidenceImage.sampleRegions({
  collection: candidatePoints,
  properties: ['LULC', 'class_name', 'year'],
  scale: 10,
  geometries: true,
  tileScale: 4
});

// Display results
print('2019 Evidence Count:', evidence.size());
print('2019 Evidence Preview:', evidence.limit(10));

// Export CSV
Export.table.toDrive({
  collection: evidence,
  description: 'Godavari_2019_All180_Evidence_Combined',
  fileFormat: 'CSV'
});