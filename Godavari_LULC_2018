
/************************************************************
 GODAVARI BASIN — LULC 2018
 Dynamic World | Six classes
 Outputs:
 1. Preliminary class-wise area
 2. LULC map export
 3. Candidate points CSV
************************************************************/

// 1. Study area
var basin = ee.FeatureCollection(
  'projects/fine-slice-478618-n5/assets/Godavari_Basin'
);
var geometry = basin.geometry();

Map.centerObject(basin, 6);
Map.addLayer(
  basin.style({color: 'red', fillColor: '00000000', width: 2}),
  {},
  'Godavari Basin'
);

// 2. Dynamic World images for 2018
var dw = ee.ImageCollection('GOOGLE/DYNAMICWORLD/V1')
  .filterBounds(geometry)
  .filterDate('2018-01-01', '2019-01-01');

print('Dynamic World image count, 2018:', dw.size());

// 3. Annual mode composite
var label = dw.select('label').mode().clip(geometry);

// Dynamic World original classes:
// 0 water       -> 0 water
// 1 trees       -> 1 forest
// 2 grass       -> 5 grassland/wasteland
// 3 flooded veg -> 0 water
// 4 crops       -> 2 agriculture
// 5 shrub       -> 5 grassland/wasteland
// 6 built       -> 3 built-up
// 7 bare        -> 4 barren
// 8 snow/ice    -> 4 barren

var lulc2018 = label.remap(
  [0, 1, 2, 3, 4, 5, 6, 7, 8],
  [0, 1, 5, 0, 2, 5, 3, 4, 4]
).rename('LULC').toByte();

var classNames = [
  'Water',
  'Forest',
  'Agriculture',
  'Built-up',
  'Barren',
  'Grassland/wasteland'
];

var palette = [
  '419BDF',
  '397D49',
  'E6A83D',
  'C4281B',
  'B8A58A',
  '88B053'
];

Map.addLayer(
  lulc2018,
  {min: 0, max: 5, palette: palette},
  'Godavari LULC 2018'
);

// 4. Preliminary area calculation (scale 100 m)
var areaImage = ee.Image.pixelArea()
  .divide(10000)
  .rename('area_ha')
  .addBands(lulc2018);

var areaStats = areaImage.reduceRegion({
  reducer: ee.Reducer.sum().group({
    groupField: 1,
    groupName: 'class'
  }),
  geometry: geometry,
  scale: 100,
  maxPixels: 1e13,
  tileScale: 8
});

var groups = ee.List(areaStats.get('groups'));

var areaTable = ee.FeatureCollection(groups.map(function(item) {
  item = ee.Dictionary(item);
  var classId = ee.Number(item.get('class')).toInt();

  return ee.Feature(null, {
    year: 2018,
    class_id: classId,
    class_name: ee.List(classNames).get(classId),
    area_ha: item.get('sum'),
    area_km2: ee.Number(item.get('sum')).divide(100)
  });
}));

print('2018 preliminary area by class:', areaTable);
print(
  '2018 total mapped area (km²):',
  areaTable.aggregate_sum('area_km2')
);

// 5. Export LULC map at 10 m
Export.image.toDrive({
  image: lulc2018,
  description: 'Godavari_LULC_2018_Map',
  folder: 'Godavari_LULC',
  fileNamePrefix: 'Godavari_LULC_2018',
  region: geometry,
  scale: 10,
  maxPixels: 1e13,
  fileFormat: 'GeoTIFF'
});

// 6. Candidate sample points: target 30 per class
var samples2018 = lulc2018.stratifiedSample({
  numPoints: 30,
  classBand: 'LULC',
  region: geometry,
  scale: 100,
  seed: 2018,
  geometries: true,
  tileScale: 8
}).map(function(feature) {
  var classId = ee.Number(feature.get('LULC')).toInt();

  return feature.set({
    year: 2018,
    class_name: ee.List(classNames).get(classId)
  });
});

print('2018 candidate point count:', samples2018.size());
print('2018 candidate points by class:',
  samples2018.aggregate_histogram('LULC'));

Map.addLayer(
  samples2018,
  {color: 'yellow'},
  '2018 candidate points'
);

// 7. Export candidate points CSV
Export.table.toDrive({
  collection: samples2018,
  description: 'Godavari_LULC_2018_Candidate_Points',
  folder: 'Godavari_LULC',
  fileNamePrefix: 'Godavari_LULC_2018_Candidate_Points',
  fileFormat: 'CSV'
});

/************************************************************
 GODAVARI BASIN — 2018 EVIDENCE EXTRACTION
 Requires existing variables:
 basin, geometry, lulc2018, samples2018
************************************************************/

// 1. ESA WorldCover 2021 candidate reference
// NOTE: This is a screening layer, NOT 2018 ground truth.

var esa = ee.ImageCollection('ESA/WorldCover/v200')
  .first()
  .select('Map')
  .clip(geometry);

// ESA classes mapped to our six classes:
// 10 tree cover -> 1 forest
// 20 shrubland, 30 grassland -> 5 grassland/wasteland
// 40 cropland -> 2 agriculture
// 50 built-up -> 3 built-up
// 60 bare/sparse -> 4 barren
// 80 water -> 0 water
// 90 herbaceous wetland, 95 mangroves, 100 moss/lichen -> 5
// Other classes are marked -1 for exclusion from comparison.

var esaCandidate = esa.remap(
  [10, 20, 30, 40, 50, 60, 70, 80, 90, 95, 100],
  [ 1,  5,  5,  2,  3,  4, -1,  0,  5,  5,   5],
  -1
).rename('ESA_candidate').toInt16();

// 2. Sentinel-2 surface reflectance evidence for 2018

var s2 = ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED')
  .filterBounds(geometry)
  .filterDate('2018-01-01', '2019-01-01')
  .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 30));

print('2018 Sentinel-2 image count:', s2.size());

var s2Composite = s2
  .select(['B2', 'B3', 'B4', 'B8'])
  .median()
  .clip(geometry);

var ndvi = s2Composite.normalizedDifference(['B8', 'B4'])
  .rename('NDVI');

var ndwi = s2Composite.normalizedDifference(['B3', 'B8'])
  .rename('NDWI');

var evidenceImage = lulc2018.rename('Predicted')
  .addBands(esaCandidate)
  .addBands(s2Composite)
  .addBands(ndvi)
  .addBands(ndwi);

// 3. Extract evidence at all 180 candidate points

var evidence2018 = evidenceImage.sampleRegions({
  collection: samples2018,
  properties: ['LULC', 'class_name', 'year'],
  scale: 10,
  geometries: true,
  tileScale: 8
}).map(function(feature) {
  var predicted = ee.Number(feature.get('Predicted'));
  var esaClass = ee.Number(feature.get('ESA_candidate'));

  var validESA = esaClass.gte(0);
  var disagreement = esaClass.neq(predicted);

  var needsReview = validESA.and(disagreement);

  return feature.set({
    ESA_valid: validESA,
    ESA_matches_DW: validESA.and(esaClass.eq(predicted)),
    needs_review: needsReview,
    review_status: ee.Algorithms.If(
      needsReview,
      'Review',
      ee.Algorithms.If(validESA, 'Candidate agreement', 'ESA unavailable')
    )
  });
});

print('2018 evidence point count:', evidence2018.size());
print(
  '2018 review categories:',
  evidence2018.aggregate_histogram('review_status')
);

// 4. Export complete evidence table

Export.table.toDrive({
  collection: evidence2018,
  description: 'Godavari_2018_All180_Evidence_Combined',
  folder: 'Godavari_LULC',
  fileNamePrefix: 'Godavari_2018_All180_Evidence_Combined',
  fileFormat: 'CSV'
});

// 5. Export priority-review points

var priority2018 = evidence2018.filter(
  ee.Filter.eq('needs_review', true)
);

Export.table.toDrive({
  collection: priority2018,
  description: 'Godavari_2018_Priority_Review',
  folder: 'Godavari_LULC',
  fileNamePrefix: 'Godavari_2018_Priority_Review',
  fileFormat: 'CSV'
});
