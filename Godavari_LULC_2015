// ============================================================
// GODAVARI BASIN - LULC 2015
// Dynamic World
// Training will be done later
// ============================================================


// 1. LOAD GODAVARI BASIN
var basin = ee.FeatureCollection(
  "projects/fine-slice-478618-n5/assets/Godavari_Basin"
);

Map.centerObject(basin, 7);

Map.addLayer(
  basin.style({
    color: "red",
    fillColor: "00000000",
    width: 2
  }),
  {},
  "Godavari Basin"
);


// 2. LOAD DYNAMIC WORLD 2015

var dw2015 = ee.ImageCollection(
  "GOOGLE/DYNAMICWORLD/V1"
)
  .filterBounds(basin)
  .filterDate("2015-06-27", "2016-01-01")
  .select("label")
  .mode()
  .clip(basin);


// 3. PRINT INFORMATION

print("Dynamic World 2015:", dw2015);


// 4. DISPLAY ORIGINAL DYNAMIC WORLD

var dwPalette = [
  "419BDF", // Water
  "397D49", // Trees
  "88B053", // Grass
  "7A87C6", // Flooded vegetation
  "E49635", // Crops
  "DFC35A", // Shrub
  "C4281B", // Built
  "A59B8F", // Bare
  "B39FE1"  // Snow/Ice
];

Map.addLayer(
  dw2015,
  {
    min: 0,
    max: 8,
    palette: dwPalette
  },
  "Dynamic World 2015"
);


// 5. CONVERT TO OUR 6 PROJECT CLASSES

// 0 = Water
// 1 = Forest
// 2 = Agriculture
// 3 = Built-up
// 4 = Barren
// 5 = Grassland/Wasteland

var lulc2015 = ee.Image(0)
  .where(dw2015.eq(0), 0)  // Water
  .where(dw2015.eq(1), 1)  // Trees → Forest
  .where(dw2015.eq(2), 5)  // Grass → Grassland
  .where(dw2015.eq(3), 0)  // Flooded vegetation → Water
  .where(dw2015.eq(4), 2)  // Crops → Agriculture
  .where(dw2015.eq(5), 5)  // Shrub → Grassland
  .where(dw2015.eq(6), 3)  // Built → Built-up
  .where(dw2015.eq(7), 4)  // Bare → Barren
  .where(dw2015.eq(8), 4)  // Snow/Ice → Barren
  .rename("LULC")
  .clip(basin);


// 6. DISPLAY 6-CLASS LULC

var lulcPalette = [
  "419BDF", // Water
  "397D49", // Forest
  "E49635", // Agriculture
  "C4281B", // Built-up
  "A59B8F", // Barren
  "88B053"  // Grassland/Wasteland
];

Map.addLayer(
  lulc2015,
  {
    min: 0,
    max: 5,
    palette: lulcPalette
  },
  "Godavari LULC 2015"
);


// 7. CALCULATE AREA

var areaImage = ee.Image.pixelArea()
  .divide(10000)
  .addBands(lulc2015);

var area2015 = areaImage.reduceRegion({

  reducer: ee.Reducer.sum()
    .group({
      groupField: 1,
      groupName: "class"
    }),

  geometry: basin.geometry(),

  scale: 100,

  bestEffort: true,

  maxPixels: 1e13,

  tileScale: 4
});

print(
  "2015 LULC Area (hectares):",
  area2015
);


// 8. CLASS INFORMATION

print(
  "Classes:",
  "0 Water | 1 Forest | 2 Agriculture | " +
  "3 Built-up | 4 Barren | 5 Grassland/Wasteland"
);


// 9. EXPORT 2015 LULC

Export.image.toDrive({

  image: lulc2015.toByte(),

  description: "Godavari_LULC_2015",

  folder: "Godavari_LULC",

  fileNamePrefix: "Godavari_LULC_2015",

  region: basin.geometry(),

  scale: 10,

  maxPixels: 1e13

});