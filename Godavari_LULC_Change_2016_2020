// ------------------------------------------------------------
// 2. DYNAMIC WORLD → 6 PROJECT LULC CLASSES
// ------------------------------------------------------------

function getLULC(startDate, endDate) {

  var dw = ee.ImageCollection(
    "GOOGLE/DYNAMICWORLD/V1"
  )
  .filterDate(startDate, endDate)
  .filterBounds(basin)
  .select("label");

  var dwMode = dw.mode();

  var lulc = dwMode.remap(
    [0, 1, 2, 3, 4, 5, 6, 7, 8],
    [0, 1, 5, 0, 2, 5, 3, 4, 4]
  );

  return lulc.clip(basin);
}


