function calculateChangedArea(
  image1,
  image2,
  year1,
  year2
) {

  var changedArea = ee.Image.pixelArea()
    .divide(10000)
    .updateMask(
      image1.neq(image2)
    );

  var result = changedArea.reduceRegion({

    reducer: ee.Reducer.sum(),

    geometry: basin.geometry(),

    scale: 100,

    bestEffort: true,

    maxPixels: 1e13,

    tileScale: 4

  });

  print(
    'Changed Area ' +
    year1 +
    '-' +
    year2 +
    ' (ha)',
    result
  );

  return result;
}


