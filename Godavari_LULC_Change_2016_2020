// ------------------------------------------------------------
// 7. AREA CALCULATION FUNCTION
// ------------------------------------------------------------

function calculateArea(image, year) {

  var areaImage = ee.Image.pixelArea()
    .divide(10000)
    .addBands(image);

  var area = areaImage.reduceRegion({

    reducer: ee.Reducer.sum().group({
      groupField: 1,
      groupName: 'class'
    }),

    geometry: basin.geometry(),

    scale: 100,

    bestEffort: true,

    maxPixels: 1e13,

    tileScale: 4

  });

  print(
    'LULC Area - ' + year,
    area
  );

  return area;
}


