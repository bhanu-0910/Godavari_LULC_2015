// ------------------------------------------------------------
// 13. TRANSITION MATRIX FUNCTION
// ------------------------------------------------------------

function transitionMatrix(
  image1,
  image2,
  year1,
  year2
) {

  // Example:
  // 1 → 2 becomes 12
  // 5 → 3 becomes 53

  var transition = image1
    .multiply(10)
    .add(image2);

  var transitionArea = ee.Image.pixelArea()
    .divide(10000)
    .addBands(transition);

  var result = transitionArea.reduceRegion({

    reducer: ee.Reducer.sum().group({
      groupField: 1,
      groupName: 'transition'
    }),

    geometry: basin.geometry(),

    scale: 100,

    bestEffort: true,

    maxPixels: 1e13,

    tileScale: 4

  });

  print(
    'Transition Matrix ' +
    year1 +
    ' -> ' +
    year2,
    result
  );

  return result;
}


