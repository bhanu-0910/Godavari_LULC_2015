// ------------------------------------------------------------
// 9. FUNCTION FOR CHANGE MAP
// ------------------------------------------------------------

function createChangeMap(
  image1,
  image2,
  year1,
  year2
) {

  var change = image1
    .neq(image2)
    .selfMask();

  Map.addLayer(
    change,
    {palette: ['FFFF00']},
    'Change ' + year1 + '-' + year2
  );

  return change;
}


