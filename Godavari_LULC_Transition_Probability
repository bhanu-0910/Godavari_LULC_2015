// ============================================================
// GODAVARI BASIN - LULC TRANSITION PROBABILITY
// Base Period: 2016 -> 2020
// ============================================================


// ------------------------------------------------------------
// 1. LOAD GODAVARI BASIN
// ------------------------------------------------------------

var basin = ee.FeatureCollection(
  "projects/fine-slice-478618-n5/assets/Godavari_Basin"
);

Map.centerObject(basin, 7);


// ------------------------------------------------------------
// 2. FUNCTION TO CREATE 6-CLASS LULC
// ------------------------------------------------------------

function getLULC(startDate, endDate) {

  var dw = ee.ImageCollection(
    "GOOGLE/DYNAMICWORLD/V1"
  )
  .filterDate(startDate, endDate)
  .filterBounds(basin)
  .select("label");

  var mode = dw.mode();

  return mode.remap(
    [0, 1, 2, 3, 4, 5, 6, 7, 8],
    [0, 1, 5, 0, 2, 5, 3, 4, 4]
  ).clip(basin);
}


// ------------------------------------------------------------
// 3. CREATE 2016 AND 2020 LULC
// ------------------------------------------------------------

var lulc2016 = getLULC(
  '2016-01-01',
  '2017-01-01'
);

var lulc2020 = getLULC(
  '2020-01-01',
  '2021-01-01'
);


// ------------------------------------------------------------
// 4. LULC COLORS
// ------------------------------------------------------------

var palette = [
  '419BDF',  // Water
  '397D49',  // Forest
  'E49635',  // Agriculture
  'C4281B',  // Built-up
  'A59B8F',  // Barren
  '88B053'   // Grassland/Wasteland
];


// ------------------------------------------------------------
// 5. DISPLAY 2020 LULC
// ------------------------------------------------------------

Map.addLayer(
  lulc2020,
  {
    min: 0,
    max: 5,
    palette: palette
  },
  'LULC 2020'
);


// ------------------------------------------------------------
// 6. CREATE TRANSITION IMAGE
// ------------------------------------------------------------

// 2016 class × 10 + 2020 class
//
// 0  = Water -> Water
// 12 = Forest -> Agriculture
// 23 = Agriculture -> Built-up
// 52 = Grassland -> Agriculture

var transition = lulc2016
  .multiply(10)
  .add(lulc2020)
  .rename('transition');


// ------------------------------------------------------------
// 7. CALCULATE TRANSITION AREAS
// ------------------------------------------------------------

var transitionAreaImage = ee.Image.pixelArea()
  .divide(10000)
  .addBands(transition);

var transitionResult = transitionAreaImage.reduceRegion({

  reducer: ee.Reducer.sum().group({
    groupField: 1,
    groupName: 'transition'
  }),

  geometry: basin.geometry(),

  scale: 100,

  bestEffort: true,

  maxPixels: 1e13,

  tileScale: 4

});

print(
  '2016 -> 2020 TRANSITION AREAS (ha)',
  transitionResult
);


// ------------------------------------------------------------
// 8. GET GROUPED RESULTS
// ------------------------------------------------------------

var groups = ee.List(
  transitionResult.get('groups')
);


// ------------------------------------------------------------
// 9. CREATE DICTIONARY
// ------------------------------------------------------------

// IMPORTANT:
// Force transition code to integer string.
// This avoids the zero-matrix problem.

var transitionDictionary = ee.Dictionary(
  groups.iterate(

    function(item, dictionary) {

      item = ee.Dictionary(item);

      dictionary = ee.Dictionary(dictionary);

      var transitionCode = ee.Number(
        item.get('transition')
      ).toInt();

      var area = ee.Number(
        item.get('sum')
      );

      return dictionary.set(
        transitionCode.format('%d'),
        area
      );

    },

    ee.Dictionary({})
  )
);


print(
  'TRANSITION DICTIONARY',
  transitionDictionary
);


// ------------------------------------------------------------
// 10. FUNCTION TO GET TRANSITION AREA
// ------------------------------------------------------------

function getTransitionArea(fromClass, toClass) {

  var code = ee.Number(fromClass)
    .multiply(10)
    .add(ee.Number(toClass))
    .toInt()
    .format('%d');

  return ee.Number(
    transitionDictionary.get(
      code,
      0
    )
  );
}


// ------------------------------------------------------------
// 11. CREATE 6 × 6 AREA MATRIX
// ------------------------------------------------------------

var transitionAreaMatrix = ee.List.sequence(0, 5)
  .map(

    function(fromClass) {

      return ee.List.sequence(0, 5)
        .map(

          function(toClass) {

            return getTransitionArea(
              fromClass,
              toClass
            );

          }

        );

    }

  );


print(
  '2016 -> 2020 TRANSITION AREA MATRIX (ha)',
  transitionAreaMatrix
);


// ------------------------------------------------------------
// 12. CREATE PROBABILITY MATRIX
// ------------------------------------------------------------

var probabilityMatrix = transitionAreaMatrix.map(

  function(row) {

    row = ee.List(row);

    var rowTotal = ee.Number(
      row.reduce(ee.Reducer.sum())
    );

    return row.map(

      function(value) {

        value = ee.Number(value);

        return ee.Algorithms.If(

          rowTotal.gt(0),

          value.divide(rowTotal),

          0

        );

      }

    );

  }

);


print(
  '2016 -> 2020 TRANSITION PROBABILITY MATRIX',
  probabilityMatrix
);


// ------------------------------------------------------------
// 13. CHECK PROBABILITY ROW TOTALS
// ------------------------------------------------------------

var rowTotals = probabilityMatrix.map(

  function(row) {

    return ee.Number(
      ee.List(row).reduce(
        ee.Reducer.sum()
      )
    );

  }

);


print(
  'PROBABILITY ROW TOTALS',
  rowTotals
);


// ------------------------------------------------------------
// 14. CLASS NAMES
// ------------------------------------------------------------

print('==========================================');

print('CLASS 0 = WATER');
print('CLASS 1 = FOREST');
print('CLASS 2 = AGRICULTURE');
print('CLASS 3 = BUILT-UP');
print('CLASS 4 = BARREN');
print('CLASS 5 = GRASSLAND/WASTELAND');

print('==========================================');


// ------------------------------------------------------------
// 15. 2016 CLASS AREAS
// ------------------------------------------------------------

var area2016Image = ee.Image.pixelArea()
  .divide(10000)
  .addBands(lulc2016);

var area2016Result = area2016Image.reduceRegion({

  reducer: ee.Reducer.sum().group({
    groupField: 1,
    groupName: 'class'
  }),

  geometry: basin.geometry(),

  scale: 100,

  bestEffort: true,

  maxPixels: 1e13,

  tileScale: 4

});


print(
  '2016 CLASS AREAS (ha)',
  area2016Result
);


// ------------------------------------------------------------
// 16. 2020 CLASS AREAS
// ------------------------------------------------------------

var area2020Image = ee.Image.pixelArea()
  .divide(10000)
  .addBands(lulc2020);

var area2020Result = area2020Image.reduceRegion({

  reducer: ee.Reducer.sum().group({
    groupField: 1,
    groupName: 'class'
  }),

  geometry: basin.geometry(),

  scale: 100,

  bestEffort: true,

  maxPixels: 1e13,

  tileScale: 4

});


print(
  '2020 CLASS AREAS (ha)',
  area2020Result
);


