// ============================================================
// GODAVARI BASIN - LULC TRANSITION PROBABILITY
// Base period: 2016 -> 2020
// ============================================================


// ------------------------------------------------------------
// 1. LOAD BASIN
// ------------------------------------------------------------

var basin = ee.FeatureCollection(
  "projects/fine-slice-478618-n5/assets/Godavari_Basin"
);

Map.centerObject(basin, 7);


// ------------------------------------------------------------
// 2. FUNCTION TO CREATE 6-CLASS LULC
// ------------------------------------------------------------

function getLULC(startDate, endDate) {

  var dw = ee.ImageCollection(
    "GOOGLE/DYNAMICWORLD/V1"
  )
  .filterDate(startDate, endDate)
  .filterBounds(basin)
  .select("label");

  var mode = dw.mode();

  return mode.remap(
    [0, 1, 2, 3, 4, 5, 6, 7, 8],
    [0, 1, 5, 0, 2, 5, 3, 4, 4]
  ).clip(basin);
}


// ------------------------------------------------------------
// 3. CREATE 2016 AND 2020 LULC
// ------------------------------------------------------------

var lulc2016 = getLULC(
  '2016-01-01',
  '2017-01-01'
);

var lulc2020 = getLULC(
  '2020-01-01',
  '2021-01-01'
);


// ------------------------------------------------------------
// 4. CREATE TRANSITION CODE
// ------------------------------------------------------------

// Example:
// 0 -> 0 = 0
// 1 -> 2 = 12
// 5 -> 3 = 53

var transition = lulc2016
  .multiply(10)
  .add(lulc2020);


// ------------------------------------------------------------
// 5. CALCULATE TRANSITION AREAS
// ------------------------------------------------------------

var transitionArea = ee.Image.pixelArea()
  .divide(10000)
  .addBands(transition);

var transitionResult = transitionArea.reduceRegion({

  reducer: ee.Reducer.sum().group({
    groupField: 1,
    groupName: 'transition'
  }),

  geometry: basin.geometry(),

  scale: 100,

  bestEffort: true,

  maxPixels: 1e13,

  tileScale: 4

});

print(
  '2016 -> 2020 TRANSITION AREAS (ha)',
  transitionResult
);


// ------------------------------------------------------------
// 6. CREATE TRANSITION AREA MATRIX
// ------------------------------------------------------------

// Convert grouped result into a dictionary

var groups = ee.List(
  transitionResult.get('groups')
);


// Create a 6 x 6 matrix

var transitionMatrix = ee.List.sequence(0, 5)
  .map(function(fromClass) {

    fromClass = ee.Number(fromClass);

    return ee.List.sequence(0, 5)
      .map(function(toClass) {

        toClass = ee.Number(toClass);

        var code = fromClass
          .multiply(10)
          .add(toClass);

        var match = groups.filter(
          ee.Filter.eq(
            'transition',
            code
          )
        );

        var area = ee.Algorithms.If(
          ee.List(match).size().gt(0),

          ee.Dictionary(
            ee.List(match).get(0)
          ).get('sum'),

          0
        );

        return ee.Number(area);

      });

  });


print(
  'TRANSITION AREA MATRIX (ha)',
  transitionMatrix
);


// ------------------------------------------------------------
// 7. CONVERT TRANSITION AREAS TO PROBABILITIES
// ------------------------------------------------------------

// Each row is divided by its row total.
// Therefore every row should sum approximately to 1.

// Example:
//
// Forest -> Water
// Forest -> Forest
// Forest -> Agriculture
// etc.

var probabilityMatrix = transitionMatrix.map(
  function(row) {

    row = ee.List(row);

    var rowTotal = ee.Number(
      row.reduce(ee.Reducer.sum())
    );

    return row.map(
      function(value) {

        value = ee.Number(value);

        return ee.Algorithms.If(
          rowTotal.gt(0),
          value.divide(rowTotal),
          0
        );

      }
    );

  }
);


// ------------------------------------------------------------
// 8. PRINT PROBABILITY MATRIX
// ------------------------------------------------------------

print(
  '2016 -> 2020 TRANSITION PROBABILITY MATRIX',
  probabilityMatrix
);


// ------------------------------------------------------------
// 9. CLASS INFORMATION
// ------------------------------------------------------------

print('==========================================');

print('CLASS 0 = WATER');
print('CLASS 1 = FOREST');
print('CLASS 2 = AGRICULTURE');
print('CLASS 3 = BUILT-UP');
print('CLASS 4 = BARREN');
print('CLASS 5 = GRASSLAND/WASTELAND');

print('==========================================');


// ------------------------------------------------------------
// 10. VISUALIZE 2020 LULC
// ------------------------------------------------------------

var palette = [
  '419BDF',
  '397D49',
  'E49635',
  'C4281B',
  'A59B8F',
  '88B053'
];

Map.addLayer(
  lulc2020,
  {
    min: 0,
    max: 5,
    palette: palette
  },
  'LULC 2020'
);