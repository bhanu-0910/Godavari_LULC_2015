
// GODAVARI BASIN - CMIP6 SCENARIO INSPECTION

var basin = ee.FeatureCollection(
  'projects/fine-slice-478618-n5/assets/Godavari_Basin'
);

var cmip6 = ee.ImageCollection('NASA/GDDP-CMIP6');

var scenarios = ['historical', 'ssp245', 'ssp585'];

scenarios.forEach(function(scenario) {

  var collection = cmip6
    .filterBounds(basin)
    .filter(ee.Filter.eq('scenario', scenario))
    .filterDate('2015-01-01', '2016-01-01')
    .limit(100);

  print(scenario + ' image count:', collection.size());

  print(scenario + ' first image:',
        collection.first());

});

