
// GODAVARI - CMIP6 HISTORICAL DATA CHECK

var cmip6 = ee.ImageCollection('NASA/GDDP-CMIP6');

var historical = cmip6
  .filterDate('2010-01-01', '2015-01-01')
  .limit(20);

print('Historical sample count:', historical.size());
print('Historical sample:', historical.first());

var future = cmip6
  .filterDate('2021-01-01', '2022-01-01')
  .filter(ee.Filter.eq('scenario', 'ssp245'))
  .limit(20);

print('Future sample count:', future.size());
print('Future sample:', future.first());
