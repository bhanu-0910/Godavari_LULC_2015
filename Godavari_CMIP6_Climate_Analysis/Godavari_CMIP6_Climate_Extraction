
/************************************************************
 GODAVARI BASIN - CMIP6 CLIMATE EXTRACTION
 Historical + SSP245 + SSP585
 Variables: Precipitation, TASMAX, TASMIN
************************************************************/

// 1. Basin
var basin = ee.FeatureCollection(
  'projects/fine-slice-478618-n5/assets/Godavari_Basin'
);

Map.centerObject(basin, 6);
Map.addLayer(basin, {}, 'Godavari Basin');

// 2. Dataset
var cmip6 = ee.ImageCollection('NASA/GDDP-CMIP6');

// 3. Common models identified in previous checks
var models = ee.List([
  'ACCESS-CM2',
  'ACCESS-ESM1-5',
  'BCC-CSM2-MR',
  'CESM2',
  'CESM2-WACCM',
  'CMCC-CM2-SR5',
  'CMCC-ESM2',
  'CNRM-CM6-1',
  'CNRM-ESM2-1',
  'CanESM5',
  'EC-Earth3',
  'EC-Earth3-Veg-LR',
  'FGOALS-g3',
  'GFDL-CM4',
  'GFDL-ESM4',
  'GISS-E2-1-G',
  'HadGEM3-GC31-LL',
  'IITM-ESM',
  'INM-CM4-8',
  'INM-CM5-0',
  'IPSL-CM6A-LR',
  'KACE-1-0-G',
  'KIOST-ESM',
  'MIROC-ES2L',
  'MIROC6',
  'MPI-ESM1-2-HR',
  'MPI-ESM1-2-LR',
  'MRI-ESM2-0',
  'NESM3',
  'NorESM2-LM',
  'NorESM2-MM',
  'TaiESM1',
  'UKESM1-0-LL'
]);

// 4. Function to calculate period statistics
function calculateClimate(scenario, start, end, period) {

  var collection = cmip6
    .filterBounds(basin)
    .filterDate(start, end)
    .filter(ee.Filter.eq('scenario', scenario))
    .filter(ee.Filter.inList('model', models));

  print(period + ' image count:', collection.size());

  // Precipitation: kg m-2 s-1 to mm/day.
  // Sum daily precipitation, then average annual total
  // across models and years.
  var precipitation = collection
    .select('pr')
    .map(function(image) {
      return image.multiply(86400).rename('Precipitation');
    })
    .sum()
    .divide(models.size().multiply(
      ee.Date(end).difference(ee.Date(start), 'year')
    ));

  // Temperature: Kelvin to Celsius
  var maximumTemperature = collection
    .select('tasmax')
    .mean()
    .subtract(273.15)
    .rename('TASMAX');

  var minimumTemperature = collection
    .select('tasmin')
    .mean()
    .subtract(273.15)
    .rename('TASMIN');

  var climateImage = precipitation
    .addBands(maximumTemperature)
    .addBands(minimumTemperature);

  var statistics = climateImage.reduceRegion({
    reducer: ee.Reducer.mean(),
    geometry: basin.geometry(),
    scale: 25000,
    maxPixels: 1e13,
    tileScale: 4
  });

  return ee.Feature(null, {
    Scenario: scenario,
    Period: period,
    Start_Date: start,
    End_Date: end,
    Model_Count: models.size(),
    Mean_Annual_Precipitation_mm: statistics.get('Precipitation'),
    Mean_TASMAX_C: statistics.get('TASMAX'),
    Mean_TASMIN_C: statistics.get('TASMIN')
  });
}

// 5. Calculate all five analysis periods
var results = ee.FeatureCollection([

  calculateClimate(
    'historical',
    '1995-01-01',
    '2015-01-01',
    'Historical_1995_2014'
  ),

  calculateClimate(
    'ssp245',
    '2031-01-01',
    '2051-01-01',
    'SSP245_2031_2050'
  ),

  calculateClimate(
    'ssp245',
    '2081-01-01',
    '2101-01-01',
    'SSP245_2081_2100'
  ),

  calculateClimate(
    'ssp585',
    '2031-01-01',
    '2051-01-01',
    'SSP585_2031_2050'
  ),

  calculateClimate(
    'ssp585',
    '2081-01-01',
    '2101-01-01',
    'SSP585_2081_2100'
  )

]);

// 6. Display results
print('CMIP6 Climate Statistics:', results);

// 7. Export CSV
Export.table.toDrive({
  collection: results,
  description: 'Godavari_CMIP6_Climate_Statistics',
  folder: 'Godavari_CMIP6_Climate_Analysis',
  fileNamePrefix: 'Godavari_CMIP6_Climate_Statistics',
  fileFormat: 'CSV'
});
