
// GODAVARI BASIN - CMIP6 COMMON MODEL SELECTION

var basin = ee.FeatureCollection(
  'projects/fine-slice-478618-n5/assets/Godavari_Basin'
);

var cmip6 = ee.ImageCollection('NASA/GDDP-CMIP6');

function getModels(scenario, date) {
  var start = ee.Date(date);
  var end = start.advance(1, 'day');

  return ee.List(
    cmip6
      .filterBounds(basin)
      .filterDate(start, end)
      .filter(ee.Filter.eq('scenario', scenario))
      .aggregate_array('model')
  ).distinct().sort();
}

// Check one date in each period
var historicalModels = getModels('historical', '2014-01-01');
var ssp245Models = getModels('ssp245', '2031-01-01');
var ssp585Models = getModels('ssp585', '2031-01-01');

// Find models common to all three
var commonModels = historicalModels
  .filter(ee.Filter.inList('item', ssp245Models))
  .filter(ee.Filter.inList('item', ssp585Models))
  .sort();

print('Historical models:', historicalModels);
print('SSP245 models:', ssp245Models);
print('SSP585 models:', ssp585Models);

print('Common models:', commonModels);
print('Number of common models:', commonModels.size());

Map.centerObject(basin, 6);
Map.addLayer(basin, {}, 'Godavari Basin');
print('Common model names:', commonModels);