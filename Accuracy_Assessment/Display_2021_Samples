
// Load Godavari Basin
var basin = ee.FeatureCollection(
  "projects/fine-slice-478618-n5/assets/Godavari_Basin"
);

// Load uploaded sample points
var samples = ee.FeatureCollection(
  "projects/fine-slice-478618-n5/assets/Godavari_LULC_2021_Samples"
);

// Load 2021 LULC map again
var dw2021 = ee.ImageCollection("GOOGLE/DYNAMICWORLD/V1")
  .filterBounds(basin)
  .filterDate("2021-01-01", "2022-01-01")
  .select("label")
  .mode()
  .clip(basin);

var lulc2021 = ee.Image(0)
  .where(dw2021.eq(0), 0)
  .where(dw2021.eq(1), 1)
  .where(dw2021.eq(2), 5)
  .where(dw2021.eq(3), 0)
  .where(dw2021.eq(4), 2)
  .where(dw2021.eq(5), 5)
  .where(dw2021.eq(6), 3)
  .where(dw2021.eq(7), 4)
  .where(dw2021.eq(8), 4)
  .rename("LULC")
  .clip(basin);

// Display basin and sample locations
Map.centerObject(basin, 7);
Map.addLayer(
  basin.style({color: "red", fillColor: "00000000", width: 2}),
  {},
  "Godavari Basin"
);

Map.addLayer(samples, {color: "yellow"}, "2021 Sample Points");

print("Sample table:", samples);
print("Sample count:", samples.size());
print("2021 LULC map:", lulc2021);

var referenceImage2021 = ee.ImageCollection("COPERNICUS/S2_SR_HARMONIZED")
  .filterBounds(basin)
  .filterDate("2021-01-01", "2022-01-01")
  .filter(ee.Filter.lt("CLOUDY_PIXEL_PERCENTAGE", 20))
  .median()
  .clip(basin);

Map.addLayer(
  referenceImage2021,
  {bands: ["B4", "B3", "B2"], min: 0, max: 3000},
  "Sentinel-2 Reference Imagery 2021"
);

 // Select one sample point to inspect
var sampleList = samples.toList(samples.size());

// Change this number from 0 to 179 to inspect another point
var sampleNumber = 0;

var selectedSample = ee.Feature(sampleList.get(sampleNumber));
var selectedPoint = selectedSample.geometry();

Map.centerObject(selectedPoint, 16);

Map.addLayer(
  selectedPoint,
  {color: "yellow"},
  "Selected Sample"
);

print("Selected sample:", selectedSample);
print("Predicted LULC class:", selectedSample.get("LULC"));


var s2Collection = ee.ImageCollection("COPERNICUS/S2_SR_HARMONIZED")
  .filterBounds(selectedPoint.buffer(500))
  .filterDate("2021-01-01", "2022-01-01")
  .filter(ee.Filter.lt("CLOUDY_PIXEL_PERCENTAGE", 40));

print("Sentinel-2 scenes found:", s2Collection.size());

var s2PointImage = s2Collection
  .sort("CLOUDY_PIXEL_PERCENTAGE")
  .first()
  .clip(selectedPoint.buffer(500));

Map.addLayer(
  s2PointImage,
  {bands: ["B4", "B3", "B2"], min: 0, max: 3000},
  "Single Sentinel-2 Scene 2021",
  true
);

Map.centerObject(selectedPoint, 16);



