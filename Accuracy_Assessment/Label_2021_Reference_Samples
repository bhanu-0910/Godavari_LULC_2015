
/***** AUTOMATED SEASONAL LULC SCREENING — ALL SAMPLES *****/

// 1. Build cloud-masked monthly Sentinel-2 composites.
var screeningMonths = [
  {name: "Jan", start: "2021-01-01", end: "2021-02-01"},
  {name: "Apr", start: "2021-04-01", end: "2021-05-01"},
  {name: "Oct", start: "2021-10-01", end: "2021-11-01"}
];

function makeMonthlyIndices(month) {
  var collection = ee.ImageCollection(
    "COPERNICUS/S2_SR_HARMONIZED"
  )
    .filterBounds(basin)
    .filterDate(month.start, month.end)
    .filter(ee.Filter.lt("CLOUDY_PIXEL_PERCENTAGE", 40))
    .map(function(image) {
      var scl = image.select("SCL");
      var clearMask = scl.neq(0)
        .and(scl.neq(1))
        .and(scl.neq(3))
        .and(scl.neq(8))
        .and(scl.neq(9))
        .and(scl.neq(10))
        .and(scl.neq(11));

      return image.updateMask(clearMask);
    });

  print(month.name + " usable scene count:", collection.size());

  var composite = collection.median();

  var ndvi = composite.normalizedDifference(["B8", "B4"])
    .rename(month.name + "_NDVI");

  var ndwi = composite.normalizedDifference(["B3", "B8"])
    .rename(month.name + "_NDWI");

  // -9999 marks missing pixels; it is not a real index value.
  return ndvi.addBands(ndwi).unmask(-9999);
}

var indexStack = ee.Image.cat(
  screeningMonths.map(makeMonthlyIndices)
);

// 2. Extract indices at every existing sample point.
var indexResults = indexStack.sampleRegions({
  collection: samples,
  properties: ["LULC"],
  scale: 10,
  geometries: true,
  tileScale: 4
});

// 3. Flag potential issues without changing original LULC labels.
var screenedSamples = indexResults.map(function(f) {
  var valid = ee.Number(f.get("Jan_NDVI")).neq(-9999)
    .and(ee.Number(f.get("Apr_NDVI")).neq(-9999))
    .and(ee.Number(f.get("Oct_NDVI")).neq(-9999));

  var janV = ee.Number(f.get("Jan_NDVI"));
  var aprV = ee.Number(f.get("Apr_NDVI"));
  var octV = ee.Number(f.get("Oct_NDVI"));

  var janW = ee.Number(f.get("Jan_NDWI"));
  var aprW = ee.Number(f.get("Apr_NDWI"));
  var octW = ee.Number(f.get("Oct_NDWI"));

  var predictedClass = ee.Number(f.get("LULC"));

  // Heuristic flag: water-labelled point with persistent
  // vegetation and negative NDWI in all three months.
  var possibleWaterError = predictedClass.eq(0)
    .and(janV.gt(0.25))
    .and(aprV.gt(0.25))
    .and(octV.gt(0.35))
    .and(janW.lt(0))
    .and(aprW.lt(0))
    .and(octW.lt(0));

  var status = ee.String(ee.Algorithms.If(
    valid.not(),
    "INSUFFICIENT_DATA",
    ee.Algorithms.If(
      possibleWaterError,
      "REVIEW_WATER_LABEL",
      "NO_WATER_FLAG"
    )
  ));

  return f.set({
    "Indices_Valid": valid,
    "Review_Flag": status
  });
});

// 4. Print summary.
print("Total screened samples:", screenedSamples.size());

print("Samples flagged for water-label review:",
  screenedSamples.filter(
    ee.Filter.eq("Review_Flag", "REVIEW_WATER_LABEL")
  ).size()
);

print("Samples with insufficient data:",
  screenedSamples.filter(
    ee.Filter.eq("Review_Flag", "INSUFFICIENT_DATA")
  ).size()
);

print("Flagged sample examples:",
  screenedSamples.filter(
    ee.Filter.eq("Review_Flag", "REVIEW_WATER_LABEL")
  ).limit(20)
);

// 5. Export the screening results.
Export.table.toDrive({
  collection: screenedSamples,
  description: "Godavari_LULC_2021_Automated_Screening",
  fileNamePrefix: "Godavari_LULC_2021_Automated_Screening",
  fileFormat: "CSV",
  selectors: [
    "LULC",
    "Jan_NDVI", "Jan_NDWI",
    "Apr_NDVI", "Apr_NDWI",
    "Oct_NDVI", "Oct_NDWI",
    "Indices_Valid",
    "Review_Flag",
    ".geo"
  ]
});
