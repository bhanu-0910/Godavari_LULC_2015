
var basin = ee.FeatureCollection(
  "projects/fine-slice-478618-n5/assets/Godavari_Basin"
);

var samples = ee.FeatureCollection(
  "projects/fine-slice-478618-n5/assets/Godavari_LULC_2021_Samples"
);

var classNames = ee.Dictionary({
  0: "Water",
  1: "Forest",
  2: "Agriculture",
  3: "Built-up",
  4: "Barren",
  5: "Grassland/Wasteland"
});

// Change this index to inspect another sample.
// Index 0 = first sample, 1 = second sample, etc.
var sampleNumber = 0;

var selectedSample = ee.Feature(
  samples.toList(1, sampleNumber).get(0)
);

var selectedPoint = selectedSample.geometry();

var s2 = ee.ImageCollection("COPERNICUS/S2_SR_HARMONIZED")
  .filterBounds(selectedPoint.buffer(500))
  .filterDate("2021-01-01", "2022-01-01")
  .filter(ee.Filter.lt("CLOUDY_PIXEL_PERCENTAGE", 40))
  .sort("CLOUDY_PIXEL_PERCENTAGE");

print("Total samples:", samples.size());
print("Sample class counts:", samples.aggregate_histogram("LULC"));
print("Sample index:", sampleNumber);
print("Coordinates:", selectedPoint.coordinates());
print("Predicted class:", classNames.get(selectedSample.get("LULC")));
print("Available Sentinel-2 scenes:", s2.size());

// Map
Map.layers().reset();
Map.centerObject(selectedPoint, 16);

Map.addLayer(
  basin.style({color: "red", fillColor: "00000000", width: 2}),
  {},
  "Godavari Basin"
);

Map.addLayer(
  ee.Image(s2.first()).clip(selectedPoint.buffer(500)),
  {bands: ["B4", "B3", "B2"], min: 200, max: 2500, gamma: 1.2},
  "2021 Reference Image"
);

// Small marker only; no large blue circle
Map.addLayer(
  selectedPoint,
  {color: "blue"},
  "Selected Sample Point"
);

// Generate independent imagery-based candidate labels
// using Dynamic World probabilities for 2021.
// These are candidates, NOT verified reference labels.

var dw2021 = ee.ImageCollection("GOOGLE/DYNAMICWORLD/V1")
  .filterBounds(basin)
  .filterDate("2021-01-01", "2022-01-01")
  .select([
    "water", "trees", "grass", "flooded_vegetation",
    "crops", "shrub_and_scrub", "built", "bare"
  ])
  .median()
  .clip(basin);

// Convert the 8 probability bands to the project's 6 classes.
var candidateProbabilities = ee.Image.cat([
  dw2021.select("water")
    .add(dw2021.select("flooded_vegetation"))
    .rename("Water"),
  dw2021.select("trees").rename("Forest"),
  dw2021.select("crops").rename("Agriculture"),
  dw2021.select("built").rename("Built-up"),
  dw2021.select("bare").rename("Barren"),
  dw2021.select("grass")
    .add(dw2021.select("shrub_and_scrub"))
    .rename("Grassland_Wasteland")
]);

var candidateClass = candidateProbabilities
  .toArray()
  .arrayArgmax()
  .arrayGet([0])
  .rename("Candidate_Reference_LULC");

// Extract candidate labels at all sample points.
var candidateTable = candidateClass.sampleRegions({
  collection: samples,
  properties: ["LULC"],
  scale: 10,
  geometries: true
});

print("Candidate labels (not verified):", candidateTable.limit(10));
print("Candidate sample count:", candidateTable.size());
print("Candidate class counts:",
      candidateTable.aggregate_histogram("Candidate_Reference_LULC"));
