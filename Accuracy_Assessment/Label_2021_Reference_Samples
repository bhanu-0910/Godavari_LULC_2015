
var basin = ee.FeatureCollection(
  "projects/fine-slice-478618-n5/assets/Godavari_Basin"
);

var samples = ee.FeatureCollection(
  "projects/fine-slice-478618-n5/assets/Godavari_LULC_2021_Samples"
);

Map.centerObject(basin, 7);

var classNames = ee.Dictionary({
  0: "Water",
  1: "Forest",
  2: "Agriculture",
  3: "Built-up",
  4: "Barren",
  5: "Grassland/Wasteland"
});

print("Total samples:", samples.size());
print("Sample class counts:", samples.aggregate_histogram("LULC"));

var sampleNumber = 1;
var selectedSample = ee.Feature(samples.toList(samples.size()).get(sampleNumber));
var selectedPoint = selectedSample.geometry();

Map.addLayer(
  basin.style({color: "red", fillColor: "00000000", width: 2}),
  {},
  "Godavari Basin"
);

Map.addLayer(samples, {color: "yellow"}, "All 180 Samples");
Map.addLayer(
  selectedPoint.buffer(20),
  {color: "blue"},
  "Selected Sample"
);

print("Sample index:", sampleNumber);
print("Predicted class code:", selectedSample.get("LULC"));
print(
  "Predicted class name:",
  classNames.get(selectedSample.get("LULC"))
);

Map.centerObject(selectedPoint, 16);

var s2 = ee.ImageCollection("COPERNICUS/S2_SR_HARMONIZED")
  .filterBounds(selectedPoint.buffer(500))
  .filterDate("2021-01-01", "2022-01-01")
  .filter(ee.Filter.lt("CLOUDY_PIXEL_PERCENTAGE", 40))
  .sort("CLOUDY_PIXEL_PERCENTAGE");

print("Available 2021 scenes:", s2.size());

var referenceImage = ee.Image(s2.first())
  .clip(selectedPoint.buffer(500));

Map.addLayer(
  referenceImage,
  {bands: ["B4", "B3", "B2"], min: 200, max: 2500, gamma: 1.2},
  "2021 Reference Image"
);

Map.centerObject(selectedPoint, 16);

print("Sample 1 coordinates:", selectedPoint.coordinates());
print("Sample 1 predicted class:", selectedSample.get("LULC"));

var sample1Location = ee.Geometry.Point([
  80.40595726720545,
  19.810996719573577
]);

Map.centerObject(sample1Location, 18);

Map.addLayer(
  sample1Location,
  {color: "blue"},
  "Sample 1 Location"
);

print("Sample 1 location:", sample1Location);


