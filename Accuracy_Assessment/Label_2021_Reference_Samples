
/************************************************************
 GODAVARI BASIN - LULC 2021 CROSS-PRODUCT COMPARISON

 Original classes:
 0 = Water
 1 = Forest
 2 = Agriculture
 3 = Built-up
 4 = Barren
 5 = Grassland/Wasteland

 IMPORTANT:
 ESA WorldCover comparison is NOT verified ground-truth
 accuracy. It measures agreement between two products.
************************************************************/


// ==========================================================
// 1. LOAD BASIN AND EXISTING SAMPLE POINTS
// ==========================================================

var basin = ee.FeatureCollection(
  "projects/fine-slice-478618-n5/assets/Godavari_Basin"
);

var samples = ee.FeatureCollection(
  "projects/fine-slice-478618-n5/assets/Godavari_LULC_2021_Samples"
);

var classNames = ee.Dictionary({
  0: "Water",
  1: "Forest",
  2: "Agriculture",
  3: "Built-up",
  4: "Barren",
  5: "Grassland/Wasteland"
});

print("Total sample points:", samples.size());
print("Original predicted class counts:",
      samples.aggregate_histogram("LULC"));


// ==========================================================
// 2. INSPECT ONE SAMPLE USING SENTINEL-2
// ==========================================================

// Change the index from 0 to 1, 2, 3... to inspect another point.
var sampleNumber = 0;

var selectedSample = ee.Feature(
  samples.toList(1, sampleNumber).get(0)
);

var selectedPoint = selectedSample.geometry();

var s2 = ee.ImageCollection("COPERNICUS/S2_SR_HARMONIZED")
  .filterBounds(selectedPoint.buffer(500))
  .filterDate("2021-01-01", "2022-01-01")
  .filter(ee.Filter.lt("CLOUDY_PIXEL_PERCENTAGE", 40))
  .sort("CLOUDY_PIXEL_PERCENTAGE");

print("Selected sample index:", sampleNumber);
print("Selected coordinates:", selectedPoint.coordinates());
print("Predicted class:",
      classNames.get(selectedSample.get("LULC")));
print("Available Sentinel-2 scenes:", s2.size());

Map.layers().reset();
Map.centerObject(selectedPoint, 16);

Map.addLayer(
  basin.style({
    color: "red",
    fillColor: "00000000",
    width: 2
  }),
  {},
  "Godavari Basin Boundary"
);

// Add the best available scene only if scenes exist.
var hasS2 = s2.size().gt(0);

var sentinelImage = ee.Image(
  ee.Algorithms.If(
    hasS2,
    s2.first(),
    ee.Image.constant([0, 0, 0]).rename(["B4", "B3", "B2"])
  )
);

Map.addLayer(
  sentinelImage.clip(selectedPoint.buffer(500)),
  {
    bands: ["B4", "B3", "B2"],
    min: 200,
    max: 2500,
    gamma: 1.2
  },
  "Sentinel-2 RGB 2021"
);

Map.addLayer(
  selectedPoint.buffer(100),
  {color: "yellow"},
  "Selected Sample - 100m buffer"
);


// ==========================================================
// 3. LOAD ESA WORLDCOVER 2021
// ==========================================================

var worldCover = ee.ImageCollection("ESA/WorldCover/v200")
  .first()
  .select("Map")
  .clip(basin);

Map.addLayer(
  worldCover,
  {
    min: 10,
    max: 100,
    palette: [
      "006400", // Tree cover
      "ffbb22", // Shrubland
      "ffff4c", // Grassland
      "f096ff", // Cropland
      "fa0000", // Built-up
      "b4b4b4", // Bare/sparse vegetation
      "f0f0f0", // Snow and ice
      "0064c8", // Permanent water
      "0096a0", // Herbaceous wetland
      "00cf75", // Mangroves
      "fae6a0"  // Moss and lichen
    ]
  },
  "ESA WorldCover 2021"
);


// ==========================================================
// 4. MAP ESA CLASSES TO THE PROJECT'S SIX CLASSES
// ==========================================================

// ESA class codes:
// 10 = Tree cover
// 20 = Shrubland
// 30 = Grassland
// 40 = Cropland
// 50 = Built-up
// 60 = Bare/sparse vegetation
// 70 = Snow and ice
// 80 = Permanent water
// 90 = Herbaceous wetland
// 95 = Mangroves
// 100 = Moss and lichen
//
// Project classes:
// 0 = Water
// 1 = Forest
// 2 = Agriculture
// 3 = Built-up
// 4 = Barren
// 5 = Grassland/Wasteland
//
// This crosswalk is approximate. Unmapped ESA classes
// are masked and excluded from the agreement calculation.

var mappedWorldCover = worldCover.remap(
  [10, 20, 30, 40, 50, 60, 80],
  [ 1,  5,  5,  2,  3,  4,  0],
  255
).rename("Reference_Candidate");

// Mask unmapped classes instead of treating them as valid labels.
mappedWorldCover = mappedWorldCover.updateMask(
  mappedWorldCover.neq(255)
);

Map.addLayer(
  mappedWorldCover,
  {
    min: 0,
    max: 5,
    palette: [
      "419BDF", // Water
      "397D49", // Forest
      "E49635", // Agriculture
      "C4281B", // Built-up
      "A59B8F", // Barren
      "88B053"  // Grassland/Wasteland
    ]
  },
  "ESA mapped to six project classes"
);


// ==========================================================
// 5. SAMPLE ESA CLASSES AT THE EXISTING 180 POINTS
// ==========================================================

var comparison = mappedWorldCover.sampleRegions({
  collection: samples,
  properties: ["LULC"],
  scale: 10,
  geometries: true
});

print("Valid comparison points:", comparison.size());
print("Mapped reference class counts:",
      comparison.aggregate_histogram("Reference_Candidate"));


// ==========================================================
// 6. ADD CLASS NAMES AND AGREEMENT FLAG
// ==========================================================

var results = comparison.map(function(feature) {
  var predicted = ee.Number(feature.get("LULC"));
  var reference = ee.Number(feature.get("Reference_Candidate"));

  return feature.set({
    "Predicted_Name": classNames.get(predicted.format()),
    "Candidate_Name": classNames.get(reference.format()),
    "Match": predicted.eq(reference)
  });
});

var matching = results.filter(
  ee.Filter.eq("Match", 1)
);

var nonMatching = results.filter(
  ee.Filter.eq("Match", 0)
);

print("Valid comparison points:", results.size());
print("Matching points:", matching.size());
print("Non-matching points:", nonMatching.size());

print("Comparison table - first 20 points:",
      results.limit(20));


// ==========================================================
// 7. CALCULATE CROSS-PRODUCT AGREEMENT
// ==========================================================

var validCount = results.size();
var matchCount = matching.size();

var agreementPercent = ee.Algorithms.If(
  validCount.gt(0),
  ee.Number(matchCount).divide(validCount).multiply(100),
  null
);

print("Cross-product agreement (%):", agreementPercent);


// ==========================================================
// 8. EXPORT COMPARISON TABLE TO GOOGLE DRIVE
// ==========================================================

Export.table.toDrive({
  collection: results,
  description: "Godavari_LULC_2021_CrossCheck",
  fileNamePrefix: "Godavari_LULC_2021_CrossCheck",
  fileFormat: "CSV",
  selectors: [
    "LULC",
    "Predicted_Name",
    "Reference_Candidate",
    "Candidate_Name",
    "Match",
    ".geo"
  ]
});

/***** STEP 2: MAP DISAGREEMENT LOCATIONS *****/

// Matching points: green
var matchingPoints = results.filter(
  ee.Filter.eq("Match", 1)
);

// Non-matching points: red
var disagreementPoints = results.filter(
  ee.Filter.eq("Match", 0)
);

Map.addLayer(
  matchingPoints.style({
    color: "00FF00",
    pointSize: 4,
    width: 1
  }),
  {},
  "Matching points"
);

Map.addLayer(
  disagreementPoints.style({
    color: "FF0000",
    pointSize: 5,
    width: 1
  }),
  {},
  "Disagreement points"
);

// Zoom out to the entire Godavari Basin
Map.centerObject(selectedPoint, 16);

print("Review these disagreement points:",
      disagreementPoints.limit(20));
print(
  "Selected Sentinel-2 image date:",
  ee.Date(ee.Image(s2.first()).get("system:time_start"))
    .format("YYYY-MM-dd")
);
