// ============================================================
// GODAVARI BASIN - CA HINDCAST 2020
// ============================================================
//
// Base LULC       : 2018
// Transition data : 2016 -> 2018
// Target year     : 2020
// Validation      : Actual 2020 LULC
//
// Classes:
// 0 = Water
// 1 = Forest
// 2 = Agriculture
// 3 = Built-up
// 4 = Barren
// 5 = Grassland/Wasteland
//
// Validation:
// Overall Accuracy
// Kappa
// Producer Accuracy
// User Accuracy
// Figure of Merit
// ============================================================


// ============================================================
// 1. LOAD GODAVARI BASIN
// ============================================================

var basin = ee.FeatureCollection(
  "projects/fine-slice-478618-n5/assets/Godavari_Basin"
);

Map.centerObject(basin, 7);


// ============================================================
// 2. FUNCTION TO CREATE 6-CLASS LULC
// ============================================================

function getLULC(startDate, endDate) {

  var dw = ee.ImageCollection(
    "GOOGLE/DYNAMICWORLD/V1"
  )
  .filterDate(startDate, endDate)
  .filterBounds(basin)
  .select("label");

  var mode = dw.mode();

  return mode.remap(
    [0, 1, 2, 3, 4, 5, 6, 7, 8],
    [0, 1, 5, 0, 2, 5, 3, 4, 4]
  ).clip(basin);
}


// ============================================================
// 3. CREATE LULC MAPS
// ============================================================

var lulc2016 = getLULC(
  "2016-01-01",
  "2017-01-01"
);

var lulc2018 = getLULC(
  "2018-01-01",
  "2019-01-01"
);

var actual2020 = getLULC(
  "2020-01-01",
  "2021-01-01"
);


// ============================================================
// 4. LULC DISPLAY COLORS
// ============================================================

var palette = [
  "419BDF",  // Water
  "397D49",  // Forest
  "E49635",  // Agriculture
  "C4281B",  // Built-up
  "A59B8F",  // Barren
  "88B053"   // Grassland/Wasteland
];


// ============================================================
// 5. 2016 -> 2018 TRANSITION IMAGE
// ============================================================

var transition2016_2018 = lulc2016
  .multiply(10)
  .add(lulc2018)
  .rename("transition");


// ============================================================
// 6. CALCULATE TRANSITION AREAS
// ============================================================

var transitionAreaImage = ee.Image.pixelArea()
  .divide(10000)
  .addBands(transition2016_2018);

var transitionResult =
  transitionAreaImage.reduceRegion({

    reducer: ee.Reducer.sum().group({
      groupField: 1,
      groupName: "transition"
    }),

    geometry: basin.geometry(),

    scale: 100,

    bestEffort: true,

    maxPixels: 1e13,

    tileScale: 4

  });


print(
  "2016 -> 2018 TRANSITION AREAS (ha)",
  transitionResult
);


// ============================================================
// 7. CREATE TRANSITION DICTIONARY
// ============================================================

var groups = ee.List(
  transitionResult.get("groups")
);


var transitionDictionary = ee.Dictionary(
  groups.iterate(

    function(item, dictionary) {

      item = ee.Dictionary(item);

      dictionary = ee.Dictionary(dictionary);

      var code = ee.Number(
        item.get("transition")
      )
      .toInt()
      .format("%d");

      var area = ee.Number(
        item.get("sum")
      );

      return dictionary.set(
        code,
        area
      );

    },

    ee.Dictionary({})
  )
);


print(
  "TRANSITION DICTIONARY",
  transitionDictionary
);


// ============================================================
// 8. FUNCTION TO GET TRANSITION AREA
// ============================================================

function getTransitionArea(
  fromClass,
  toClass
) {

  var code = ee.Number(fromClass)
    .multiply(10)
    .add(
      ee.Number(toClass)
    )
    .toInt()
    .format("%d");

  return ee.Number(
    transitionDictionary.get(
      code,
      0
    )
  );
}


// ============================================================
// 9. CREATE TRANSITION AREA MATRIX
// ============================================================

var transitionAreaMatrix =
  ee.List.sequence(0, 5)
  .map(

    function(fromClass) {

      return ee.List.sequence(0, 5)
        .map(

          function(toClass) {

            return getTransitionArea(
              fromClass,
              toClass
            );

          }

        );

    }

  );


print(
  "2016 -> 2018 TRANSITION AREA MATRIX (ha)",
  transitionAreaMatrix
);


// ============================================================
// 10. CREATE TRANSITION PROBABILITY MATRIX
// ============================================================

var transitionProbabilityMatrix =
  transitionAreaMatrix.map(

    function(row) {

      row = ee.List(row);

      var rowTotal = ee.Number(
        row.reduce(
          ee.Reducer.sum()
        )
      );

      return row.map(

        function(value) {

          value = ee.Number(value);

          return ee.Algorithms.If(

            rowTotal.gt(0),

            value.divide(rowTotal),

            0

          );

        }

      );

    }

  );


print(
  "2016 -> 2018 TRANSITION PROBABILITY MATRIX",
  transitionProbabilityMatrix
);


// ============================================================
// 11. CHECK PROBABILITY ROW TOTALS
// ============================================================

var probabilityRowTotals =
  transitionProbabilityMatrix.map(

    function(row) {

      return ee.Number(
        ee.List(row).reduce(
          ee.Reducer.sum()
        )
      );

    }

  );


print(
  "PROBABILITY ROW TOTALS",
  probabilityRowTotals
);


// ============================================================
// 12. CREATE 3 x 3 NEIGHBORHOOD KERNEL
// ============================================================

var kernel = ee.Kernel.square({

  radius: 1,

  units: "pixels",

  normalize: true

});


// ============================================================
// 13. NEIGHBORHOOD FRACTIONS FROM 2018
// ============================================================

var neighborhood0 = lulc2018
  .eq(0)
  .reduceNeighborhood({

    reducer: ee.Reducer.mean(),

    kernel: kernel

  });


var neighborhood1 = lulc2018
  .eq(1)
  .reduceNeighborhood({

    reducer: ee.Reducer.mean(),

    kernel: kernel

  });


var neighborhood2 = lulc2018
  .eq(2)
  .reduceNeighborhood({

    reducer: ee.Reducer.mean(),

    kernel: kernel

  });


var neighborhood3 = lulc2018
  .eq(3)
  .reduceNeighborhood({

    reducer: ee.Reducer.mean(),

    kernel: kernel

  });


var neighborhood4 = lulc2018
  .eq(4)
  .reduceNeighborhood({

    reducer: ee.Reducer.mean(),

    kernel: kernel

  });


var neighborhood5 = lulc2018
  .eq(5)
  .reduceNeighborhood({

    reducer: ee.Reducer.mean(),

    kernel: kernel

  });


// ============================================================
// 14. CREATE TRANSITION PROBABILITY IMAGE
// ============================================================

function probabilityImage(toClass) {

  var image = ee.Image(0);

  for (
    var fromClass = 0;
    fromClass < 6;
    fromClass++
  ) {

    var row =
      ee.List(
        transitionProbabilityMatrix
      ).get(fromClass);

    var probability =
      ee.Number(
        ee.List(row).get(toClass)
      );

    image = image.where(

      lulc2018.eq(fromClass),

      probability

    );

  }

  return image;
}


// ============================================================
// 15. PROBABILITY IMAGES FOR EACH DESTINATION CLASS
// ============================================================

var probTo0 = probabilityImage(0);

var probTo1 = probabilityImage(1);

var probTo2 = probabilityImage(2);

var probTo3 = probabilityImage(3);

var probTo4 = probabilityImage(4);

var probTo5 = probabilityImage(5);


// ============================================================
// 16. CA SUITABILITY
// ============================================================
//
// Suitability =
// transition probability × neighborhood fraction
//
// ============================================================

var suitability0 =
  probTo0.multiply(
    neighborhood0
  );

var suitability1 =
  probTo1.multiply(
    neighborhood1
  );

var suitability2 =
  probTo2.multiply(
    neighborhood2
  );

var suitability3 =
  probTo3.multiply(
    neighborhood3
  );

var suitability4 =
  probTo4.multiply(
    neighborhood4
  );

var suitability5 =
  probTo5.multiply(
    neighborhood5
  );


// ============================================================
// 17. CREATE SUITABILITY STACK
// ============================================================

var suitabilityStack =
  suitability0
    .rename("class0")

    .addBands(
      suitability1.rename("class1")
    )

    .addBands(
      suitability2.rename("class2")
    )

    .addBands(
      suitability3.rename("class3")
    )

    .addBands(
      suitability4.rename("class4")
    )

    .addBands(
      suitability5.rename("class5")
    );


// ============================================================
// 18. PREDICT 2020 LULC
// ============================================================
//
// Select the class with the highest suitability.
// ============================================================

var predicted2020 =
  suitabilityStack
    .toArray()
    .arrayArgmax()
    .arrayGet([0])
    .rename("predicted2020")
    .clip(basin);


// ============================================================
// 19. DISPLAY MAPS
// ============================================================

Map.addLayer(

  lulc2018,

  {
    min: 0,
    max: 5,
    palette: palette
  },

  "BASE LULC 2018"

);


Map.addLayer(

  predicted2020,

  {
    min: 0,
    max: 5,
    palette: palette
  },

  "PREDICTED LULC 2020"

);


Map.addLayer(

  actual2020,

  {
    min: 0,
    max: 5,
    palette: palette
  },

  "ACTUAL LULC 2020"

);


// ============================================================
// 20. CREATE CHANGE MAPS
// ============================================================

var actualChange = lulc2018
  .neq(actual2020)
  .rename("actual_change");


var predictedChange = lulc2018
  .neq(predicted2020)
  .rename("predicted_change");


// Correctly predicted change:
//
// Pixel changed in reality
// AND
// Pixel changed in prediction
// AND
// Predicted class equals actual class

var correctlyPredictedChange =
  predicted2020
    .eq(actual2020)
    .and(actualChange)
    .and(predictedChange)
    .rename("correct_change");


// ============================================================
// 21. VALIDATION SAMPLE
// ============================================================

var validationImage =
  predicted2020
    .rename("predicted")
    .addBands(
      actual2020.rename("reference")
    );


var samples =
  validationImage.sample({

    region: basin.geometry(),

    scale: 100,

    numPixels: 10000,

    seed: 42,

    geometries: false

  });


print(
  "VALIDATION SAMPLE COUNT",
  samples.size()
);


// ============================================================
// 22. CONFUSION MATRIX
// ============================================================

var confusionMatrix =
  samples.errorMatrix(

    "reference",

    "predicted"

  );


print(
  "CA HINDCAST CONFUSION MATRIX",
  confusionMatrix
);


// ============================================================
// 23. OVERALL ACCURACY
// ============================================================

print(
  "CA HINDCAST OVERALL ACCURACY",
  confusionMatrix.accuracy()
);


// ============================================================
// 24. KAPPA
// ============================================================

print(
  "CA HINDCAST KAPPA",
  confusionMatrix.kappa()
);


// ============================================================
// 25. PRODUCER ACCURACY
// ============================================================

print(
  "CA HINDCAST PRODUCER ACCURACY",
  confusionMatrix.producersAccuracy()
);


// ============================================================
// 26. USER ACCURACY
// ============================================================

print(
  "CA HINDCAST USER ACCURACY",
  confusionMatrix.consumersAccuracy()
);


// ============================================================
// 27. FIGURE OF MERIT - CORRECT CHANGE PIXELS
// ============================================================

var intersectionResult =
  correctlyPredictedChange
  .reduceRegion({

    reducer: ee.Reducer.sum(),

    geometry: basin.geometry(),

    scale: 100,

    bestEffort: true,

    maxPixels: 1e13,

    tileScale: 4

  });


print(
  "CORRECTLY PREDICTED CHANGE PIXELS",
  intersectionResult
);


// ============================================================
// 28. FIGURE OF MERIT - UNION OF CHANGES
// ============================================================

var unionChange =
  actualChange
    .or(predictedChange)
    .rename("union_change");


var unionResult =
  unionChange
  .reduceRegion({

    reducer: ee.Reducer.sum(),

    geometry: basin.geometry(),

    scale: 100,

    bestEffort: true,

    maxPixels: 1e13,

    tileScale: 4

  });


print(
  "TOTAL CHANGE UNION PIXELS",
  unionResult
);


// ============================================================
// 29. EXTRACT FOM VALUES
// ============================================================

var intersectionValue =
  ee.Number(
    intersectionResult.get(
      "correct_change"
    )
  );


var unionValue =
  ee.Number(
    unionResult.get(
      "union_change"
    )
  );


// ============================================================
// 30. CALCULATE FIGURE OF MERIT
// ============================================================

var figureOfMerit =
  ee.Algorithms.If(

    unionValue.gt(0),

    intersectionValue
      .divide(unionValue),

    0

  );


print(
  "FIGURE OF MERIT (FOM)",
  figureOfMerit
);


// ============================================================
// 31. ACTUAL CHANGE AREA
// ============================================================

var actualChangeArea =
  actualChange
    .multiply(
      ee.Image.pixelArea()
    )
    .divide(10000)
    .rename("actual_change_area");


var actualChangeAreaResult =
  actualChangeArea
  .reduceRegion({

    reducer: ee.Reducer.sum(),

    geometry: basin.geometry(),

    scale: 100,

    bestEffort: true,

    maxPixels: 1e13,

    tileScale: 4

  });


print(
  "ACTUAL CHANGE AREA 2018-2020 (ha)",
  actualChangeAreaResult
);


// ============================================================
// 32. PREDICTED CHANGE AREA
// ============================================================

var predictedChangeArea =
  predictedChange
    .multiply(
      ee.Image.pixelArea()
    )
    .divide(10000)
    .rename("predicted_change_area");


var predictedChangeAreaResult =
  predictedChangeArea
  .reduceRegion({

    reducer: ee.Reducer.sum(),

    geometry: basin.geometry(),

    scale: 100,

    bestEffort: true,

    maxPixels: 1e13,

    tileScale: 4

  });


print(
  "PREDICTED CHANGE AREA 2018-2020 (ha)",
  predictedChangeAreaResult
);


